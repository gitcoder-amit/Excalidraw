    {
      "id": "SsY3sbe2Xd4iuc9_9c2yE",
      "type": "text",
      "x": 1888.7397233576967,
      "y": 1714.765591593081,
      "width": 1100,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFi",
      "roundness": null,
      "seed": 1656771719,
      "version": 519,
      "versionNonce": 2109536311,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785418186027,
      "link": null,
      "locked": false,
      "text": "In AWS regions are the largest unit, they separate geographic locations and in one region we have\na cluster of data centers called as availability zones.\n\nAvailability zones are cluster of actual data centers, where physical AWS resources are present.\n\nEach regions has atleast 3 availability zones. which are connected via very high bandwidth physical \nconnections, and they help us to achieve fault tolerance.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In AWS regions are the largest unit, they separate geographic locations and in one region we have\na cluster of data centers called as availability zones.\n\nAvailability zones are cluster of actual data centers, where physical AWS resources are present.\n\nEach regions has atleast 3 availability zones. which are connected via very high bandwidth physical \nconnections, and they help us to achieve fault tolerance.",
      "autoResize": true,
      "lineHeight": 1.25
    },
