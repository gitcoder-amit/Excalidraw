    {
      "id": "muD3p_sDr0c5kGc6k-scG",
      "type": "text",
      "x": 1865.4936296076967,
      "y": 202.6484040930809,
      "width": 1177,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFQ",
      "roundness": null,
      "seed": 1971324807,
      "version": 355,
      "versionNonce": 1667906071,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785418186027,
      "link": null,
      "locked": false,
      "text": "Cloud is a remote place, where a lot of powerful physical machines are available for use. Sometiimes it is \nalso reffered as data centers. these all machines will be managed by there cloud providers like AWS, Azure,\nGCP. We can take these machines on rent for our usecase, or for our software to run.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cloud is a remote place, where a lot of powerful physical machines are available for use. Sometiimes it is \nalso reffered as data centers. these all machines will be managed by there cloud providers like AWS, Azure,\nGCP. We can take these machines on rent for our usecase, or for our software to run.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "daD9druobJidj5TQ0SOFi",
      "type": "text",
      "x": 1868.4975358576967,
      "y": 356.5273103430809,
      "width": 209,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFR",
      "roundness": null,
      "seed": 1699500871,
      "version": 38,
      "versionNonce": 184506073,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785418186027,
      "link": null,
      "locked": false,
      "text": "Cloud Computing -> ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cloud Computing -> ",
