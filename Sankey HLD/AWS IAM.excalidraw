    {
      "id": "QW-yPxb8AelMub29wafZU",
      "type": "text",
      "x": 2010.7709733576967,
      "y": 12205.06637284308,
      "width": 11,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
