    {
      "id": "o3kDN2DgEECQceqAEamzo",
      "type": "text",
      "x": 1988.4467546076967,
      "y": 12183.67184159308,
      "width": 1177,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIG",
      "roundness": null,
      "seed": 1083644855,
      "version": 1110,
      "versionNonce": 1616062655,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785511978184,
      "link": null,
      "locked": false,
      "text": "we will login into our AWS account we will see Account id as we are root user, there is no IAM\nrelated stuff.\n\nIAM is a global service, its not region specific we can't select any region always global, \nEC2 can be a region specific service becuase on which particular region we are actually triggering our EC2.\n\n\nWe can create IAM user, and according to need set passwork autogenerated or we can generate also\nand create group and add permissions for this groups, also we can add permission later.\n\nNow in IAM dashboard we will see all the IAM users  sign in urls, we can give to users. and we \ncan give the password and we can say use this and change your password\n\nAccount ID will be same for root user or IAM user, but for IAM it will show Its an IAM user.\n\nCost & usage access -> it will show access denied for IAM user , but for root user it will show.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we will login into our AWS account we will see Account id as we are root user, there is no IAM\nrelated stuff.\n\nIAM is a global service, its not region specific we can't select any region always global, \nEC2 can be a region specific service becuase on which particular region we are actually triggering our EC2.\n\n\nWe can create IAM user, and according to need set passwork autogenerated or we can generate also\nand create group and add permissions for this groups, also we can add permission later.\n\nNow in IAM dashboard we will see all the IAM users  sign in urls, we can give to users. and we \ncan give the password and we can say use this and change your password\n\nAccount ID will be same for root user or IAM user, but for IAM it will show Its an IAM user.\n\nCost & usage access -> it will show access denied for IAM user , but for root user it will show.",
      "autoResize": true,
      "lineHeight": 1.25
    },
