    {
      "id": "eDe90p91oYIWHixvE7Wcd",
      "type": "text",
      "x": 1971.1420671076967,
      "y": 11777.32027909308,
      "width": 1210,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bID",
      "roundness": null,
      "seed": 792388729,
      "version": 650,
      "versionNonce": 1661139959,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785419530732,
      "link": null,
      "locked": false,
      "text": "1 Free service -> AWS is not going to charge any amount for this, whatever those users are going to\n        do, AWS will charge on that.\n\n2 Eventual Consistent Service\n3 Using this we can also provide temporary access\n4 We can also apply multi factor authentication.\n5 Granular permission , lets say for EC2 only read permission is there, accordingly we can give permisssion on\n    diff diff service as well so we have very granular control, what to allocate to user and what not.\n\n6 We can also provide networking permission, like you can only access it using office network",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 Free service -> AWS is not going to charge any amount for this, whatever those users are going to\n        do, AWS will charge on that.\n\n2 Eventual Consistent Service\n3 Using this we can also provide temporary access\n4 We can also apply multi factor authentication.\n5 Granular permission , lets say for EC2 only read permission is there, accordingly we can give permisssion on\n    diff diff service as well so we have very granular control, what to allocate to user and what not.\n\n6 We can also provide networking permission, like you can only access it using office network",
      "autoResize": true,
      "lineHeight": 1.25
    },
