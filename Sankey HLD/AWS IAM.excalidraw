    {
      "id": "dCnFDRHWtNq6b9VPlsHa_",
      "type": "text",
      "x": 1879.9701921076967,
      "y": -365.7695646569191,
      "width": 1199,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
