    {
      "id": "f1AGS7uTQqF1kKNDyag0K",
      "type": "text",
      "x": 1921.4231237289837,
      "y": 4178.754143573278,
      "width": 1122,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
