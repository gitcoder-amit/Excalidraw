    {
      "id": "CvmGvynV_pxuAT3VjZWLD",
      "type": "text",
      "x": 2131.3920671076967,
      "y": 9789.23824784308,
      "width": 275,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
