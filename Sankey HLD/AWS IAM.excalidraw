      "seed": 736973585,
      "version": 398,
      "versionNonce": 864617759,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785512504815,
      "link": null,
      "locked": false,
      "text": "Any permission policy that we are attaching to a group of users, that is coming via 2 ways\nif we are attaching policy into group then all the users part of this group will also have this\npermissions, also we can attach policy to the user directly this direct attachment of policy is\ncalled as inline policy.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Any permission policy that we are attaching to a group of users, that is coming via 2 ways\nif we are attaching policy into group then all the users part of this group will also have this\npermissions, also we can attach policy to the user directly this direct attachment of policy is\ncalled as inline policy.",
      "autoResize": true,
      "lineHeight": 1.25
    },
