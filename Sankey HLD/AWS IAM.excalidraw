    },
    {
      "id": "LcmEdB7keMMT-ZKhVsuOU",
      "type": "text",
      "x": 1926.7397233576967,
      "y": 384.6484040930809,
      "width": 957,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFS",
      "roundness": null,
      "seed": 959270089,
      "version": 109,
      "versionNonce": 677961527,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785418186027,
      "link": null,
      "locked": false,
      "text": "Access of resources, using these machines to do our tasks is called as cloud computing.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Access of resources, using these machines to do our tasks is called as cloud computing.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ivz2Rn7awo5MRbMHQnnyd",
      "type": "text",
      "x": 1873.4975358576967,
      "y": 447.5273103430809,
      "width": 330,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFT",
      "roundness": null,
      "seed": 51917287,
      "version": 36,
      "versionNonce": 377557945,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785418186027,
      "link": null,
      "locked": false,
      "text": "Benefit of cloud computing -> ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Benefit of cloud computing -> ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IoBJVy6nyyR5LBnfHEOan",
      "type": "text",
      "x": 1931.8569108576967,
      "y": 481.6444978430809,
      "width": 1067,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFU",
      "roundness": null,
      "seed": 1663118151,
      "version": 554,
      "versionNonce": 1553326167,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785418186027,
      "link": null,
      "locked": false,
      "text": "its an infrastructure service for the whole world, which allows easy computing, which means, if \nwe want a powerful machine by sitting in our home, we can take just by paying rent. \nIt also provides security.\nPricing and availabilty -> they only charge, based on traffic we are holding, it will not charge\nany fix amount. these cloud providers are so robust, that can maintain very high availability. It\nis very less chances that because of AWS or Azure our appication is down.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "its an infrastructure service for the whole world, which allows easy computing, which means, if \nwe want a powerful machine by sitting in our home, we can take just by paying rent. \nIt also provides security.\nPricing and availabilty -> they only charge, based on traffic we are holding, it will not charge\nany fix amount. these cloud providers are so robust, that can maintain very high availability. It\nis very less chances that because of AWS or Azure our appication is down.",
      "autoResize": true,
      "lineHeight": 1.25
    },
