    {
      "id": "4Doo1NTsi3MZc729--zQq",
      "type": "text",
      "x": 2269.7983171076967,
      "y": 2586.011685343081,
      "width": 165,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
