    {
      "id": "f7vG6Y32GpiWMsFZivJ6l",
      "type": "text",
      "x": 1960.7592546076967,
      "y": 12755.82418534308,
      "width": 1045,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
