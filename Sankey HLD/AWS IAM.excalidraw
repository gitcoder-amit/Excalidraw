      "isDeleted": true,
      "boundElements": [],
      "updated": 1785418186027,
      "link": null,
      "locked": false,
      "text": "Client -> client is any machine or any piece of software, that is capable of making a request\nServer -> any process(piece of software) running on some machine(localmachine or any cloud machine or our own\n         ) which can collect request, process them and send response.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Client -> client is any machine or any piece of software, that is capable of making a request\nServer -> any process(piece of software) running on some machine(localmachine or any cloud machine or our own\n         ) which can collect request, process them and send response.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Igx1KFam1y_NKkRuOUCss",
      "type": "text",
      "x": 1944.1030046076967,
