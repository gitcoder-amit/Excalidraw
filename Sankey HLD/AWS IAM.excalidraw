    {
      "id": "t0wFD4atY-MSoX11nx0b0",
      "type": "text",
      "x": 1991.8451921076967,
      "y": 13272.05856034308,
      "width": 1144,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIZ",
      "roundness": null,
      "seed": 1276321375,
      "version": 837,
      "versionNonce": 1743429585,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785513369114,
      "link": null,
      "locked": false,
      "text": "if we will attach policy to Group1, it will automatically inherited to 1, 2,3, 4\nif we will attach policy to Group3, it will automatically inherited to 6, 7 user\nif a user belongs to multiple groups , then those groups policy will be inheritied to that user as well\n\nwe can add policy directly to user 8, this is called inline policy\n\nif we will remove user from a group then permissions associated with that user due to group will be \nimmediately removed. we can add policy directly to the user if we want.\n\n\nAll these policies internally defined into AWS , in the format of JSON document, this json defines, what\nall permission ,this particular policy will give. 13:00",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if we will attach policy to Group1, it will automatically inherited to 1, 2,3, 4\nif we will attach policy to Group3, it will automatically inherited to 6, 7 user\nif a user belongs to multiple groups , then those groups policy will be inheritied to that user as well\n\nwe can add policy directly to user 8, this is called inline policy\n\nif we will remove user from a group then permissions associated with that user due to group will be \nimmediately removed. we can add policy directly to the user if we want.\n\n\nAll these policies internally defined into AWS , in the format of JSON document, this json defines, what\nall permission ,this particular policy will give. 13:00",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
