    {
      "id": "muD3p_sDr0c5kGc6k-scG",
      "type": "text",
      "x": 1865.3764421076967,
      "y": 202.5273103430809,
      "width": 1177,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFQ",
      "roundness": null,
      "seed": 1971324807,
      "version": 352,
      "versionNonce": 216399335,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784819517125,
      "link": null,
      "locked": false,
      "text": "Cloud is a remote place, where a lot of powerful physical machines are available for use. Sometiimes it is \nalso reffered as data centers. these all machines will be managed by there cloud providers like AWS, Azure,\nGCP. We can take these machines on rent for our usecase, or for our software to run.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cloud is a remote place, where a lot of powerful physical machines are available for use. Sometiimes it is \nalso reffered as data centers. these all machines will be managed by there cloud providers like AWS, Azure,\nGCP. We can take these machines on rent for our usecase, or for our software to run.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "daD9druobJidj5TQ0SOFi",
      "type": "text",
      "x": 1868.3803483576967,
      "y": 356.4062165930809,
      "width": 209,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFR",
      "roundness": null,
      "seed": 1699500871,
      "version": 35,
      "versionNonce": 923536103,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784819561577,
      "link": null,
      "locked": false,
      "text": "Cloud Computing -> ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cloud Computing -> ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "LcmEdB7keMMT-ZKhVsuOU",
      "type": "text",
      "x": 1926.6225358576967,
      "y": 384.5273103430809,
      "width": 957,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFS",
      "roundness": null,
      "seed": 959270089,
      "version": 106,
      "versionNonce": 226073959,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784819603304,
      "link": null,
      "locked": false,
      "text": "Access of resources, using these machines to do our tasks is called as cloud computing.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Access of resources, using these machines to do our tasks is called as cloud computing.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ivz2Rn7awo5MRbMHQnnyd",
      "type": "text",
      "x": 1873.3803483576967,
      "y": 447.4062165930809,
      "width": 330,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFT",
      "roundness": null,
      "seed": 51917287,
      "version": 33,
      "versionNonce": 2014041575,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784819614652,
      "link": null,
      "locked": false,
      "text": "Benefit of cloud computing -> ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Benefit of cloud computing -> ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IoBJVy6nyyR5LBnfHEOan",
      "type": "text",
      "x": 1931.7397233576967,
      "y": 481.5234040930809,
      "width": 1067,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFU",
      "roundness": null,
      "seed": 1663118151,
      "version": 551,
      "versionNonce": 1925369223,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784819843724,
      "link": null,
      "locked": false,
      "text": "its an infrastructure service for the whole world, which allows easy computing, which means, if \nwe want a powerful machine by sitting in our home, we can take just by paying rent. \nIt also provides security.\nPricing and availabilty -> they only charge, based on traffic we are holding, it will not charge\nany fix amount. these cloud providers are so robust, that can maintain very high availability. It\nis very less chances that because of AWS or Azure our appication is down.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "its an infrastructure service for the whole world, which allows easy computing, which means, if \nwe want a powerful machine by sitting in our home, we can take just by paying rent. \nIt also provides security.\nPricing and availabilty -> they only charge, based on traffic we are holding, it will not charge\nany fix amount. these cloud providers are so robust, that can maintain very high availability. It\nis very less chances that because of AWS or Azure our appication is down.",
      "autoResize": true,
      "lineHeight": 1.25
    },
