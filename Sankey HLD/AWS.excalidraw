    {
      "id": "dFz0W85IpClVPixkZdl9T",
      "type": "text",
      "x": 2740.8764421076967,
      "y": 10747.52731034308,
      "width": 77,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
