    {
      "id": "dCnFDRHWtNq6b9VPlsHa_",
      "type": "text",
      "x": 1879.8530046076967,
      "y": -365.8906584069191,
      "width": 1199,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFO",
      "roundness": null,
      "seed": 883864361,
      "version": 395,
      "versionNonce": 1934030185,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784819120799,
      "link": null,
      "locked": false,
      "text": "Client -> client is any machine or any piece of software, that is capable of making a request\nServer -> any process(piece of software) running on some machine(localmachine or any cloud machine or our own\n         ) which can collect request, \n        process them and send response.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Client -> client is any machine or any piece of software, that is capable of making a request\nServer -> any process(piece of software) running on some machine(localmachine or any cloud machine or our own\n         ) which can collect request, \n        process them and send response.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Igx1KFam1y_NKkRuOUCss",
      "type": "text",
      "x": 1943.9858171076967,
      "y": -239.4687834069191,
      "width": 66,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
