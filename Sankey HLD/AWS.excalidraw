    {
      "id": "UJY-_0Jc47IdeTcDwbnYY",
      "type": "text",
      "x": 2259.8764421076967,
      "y": 9755.52731034308,
      "width": 11,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHe",
      "roundness": null,
      "seed": 1580126776,
      "version": 3,
      "versionNonce": 2052695096,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785349288420,
      "link": null,
      "locked": false,
      "text": "",
