    {
      "id": "sPHNu4LYOYWgDhmSDhDc1",
      "type": "text",
      "x": 1971.1965612289837,
      "y": 6140.773674823278,
      "width": 968,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
