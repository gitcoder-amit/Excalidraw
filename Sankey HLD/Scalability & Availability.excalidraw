      "boundElements": null,
      "updated": 1787838456844,
      "link": null,
      "locked": false,
      "text": "Once a system is properly scalable, elasticity means that there will be automatic scaling applied\non the system based on the load.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Once a system is properly scalable, elasticity means that there will be automatic scaling applied\non the system based on the load.",
      "autoResize": true,
      "lineHeight": 1.25
    },
