      "seed": 485752044,
      "version": 20,
      "versionNonce": 1584479340,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787752826074,
      "link": null,
      "locked": false,
      "text": "Scalablility -> ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scalablility -> ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gBPovPxB1err3zKQ7Jfy9",
      "type": "text",
      "x": 1890.1615983576967,
      "y": 21061.24215409308,
      "width": 1144,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bLF",
      "roundness": null,
      "seed": 995786964,
      "version": 708,
      "versionNonce": 1494236212,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787838312288,
      "link": null,
      "locked": false,
      "text": "It means that an application or system can adapt to handle higher loads.\n1 Vertical Scaling -> here we try to improve specs of our Machine , like t2.micro to any large machine\n2. Horizontal Scaling -> To achieve this we can spin up multiple EC2 instance and manage traffic on them\n    using load balancer.\ntwo type of Horizontal scaling accoring to req\n    1. Auto Scaling -> automatically EC2 will be spin up and attached to LB.\n    2. Manual Scaling.\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It means that an application or system can adapt to handle higher loads.\n1 Vertical Scaling -> here we try to improve specs of our Machine , like t2.micro to any large machine\n2. Horizontal Scaling -> To achieve this we can spin up multiple EC2 instance and manage traffic on them\n    using load balancer.\ntwo type of Horizontal scaling accoring to req\n    1. Auto Scaling -> automatically EC2 will be spin up and attached to LB.\n    2. Manual Scaling.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
