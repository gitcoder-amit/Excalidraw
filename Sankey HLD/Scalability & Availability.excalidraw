      "text": "Scalability & Availability in AWS",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "hM4ApxALamaXxC31evBrJ",
      "originalText": "Scalability & Availability in AWS",
