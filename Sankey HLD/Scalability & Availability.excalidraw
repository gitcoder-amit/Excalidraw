      "isDeleted": false,
      "boundElements": null,
      "updated": 1787838373390,
      "link": null,
      "locked": false,
      "text": "It can be achieved by putting our data in multiple availability zones. if one have some problem\nthen traffic will be redirected to other machine.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It can be achieved by putting our data in multiple availability zones. if one have some problem\nthen traffic will be redirected to other machine.",
      "autoResize": true,
      "lineHeight": 1.25
    },
