      "lineHeight": 1.25
    },
    {
      "id": "jGoEgTkdI8mw4HVmlm2OM",
      "type": "text",
      "x": 1840.0717546076967,
      "y": 21032.48434159308,
      "width": 176,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
