    },
    {
      "id": "zxAedv0_7O3oC_HCeOy89",
      "type": "text",
      "x": 1828.6664811701967,
      "y": 24738.97324758637,
      "width": 979,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOn",
      "roundness": null,
      "seed": 2101440914,
      "version": 118,
      "versionNonce": 1034836302,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789652543319,
      "created": 1789652504517,
      "link": null,
      "locked": false,
      "text": "Lets say we want to store data in databases, then what kind of storage capacity we should\nuse?",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lets say we want to store data in databases, then what kind of storage capacity we should\nuse?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "faIpA28lZYXHlFoeE0fFq",
      "type": "text",
      "x": 1863.6664811701967,
      "y": 24796.10606008637,
      "width": 11,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOo",
      "roundness": null,
      "seed": 1839592462,
      "version": 3,
      "versionNonce": 197576846,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1789652567471,
      "created": 1789652566334,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
