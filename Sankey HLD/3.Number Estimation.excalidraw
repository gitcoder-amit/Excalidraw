    {
      "id": "2Oo9Ed-RvD-cwqg7zwaEs",
      "type": "text",
      "x": 1756.7934342951967,
      "y": 22331.69590383637,
      "width": 253,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
