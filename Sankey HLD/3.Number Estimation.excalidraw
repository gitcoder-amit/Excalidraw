    {
      "id": "h5gsii-TKnTXDn2e7lNs9",
      "type": "text",
      "x": 1830.6664811701967,
      "y": 24059.10606008637,
      "width": 528,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
