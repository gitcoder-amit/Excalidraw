    {
      "id": "wH8DbxrS4B2ZDazqflIxY",
      "type": "text",
      "x": 1570.7688759187313,
      "y": 24728.422373280275,
      "width": 1122,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNX",
      "roundness": null,
      "seed": 269186355,
      "version": 673,
      "versionNonce": 1961596683,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788790259985,
      "link": null,
      "locked": false,
      "text": "All three armies are trying to attack city. the problem is all 3 have to attack together. So\nagain we need to figure out messanger mechanism that all 3 going to send messages to each \nother, This time messengers are all good. There is no problem with the messenger they are good and\nreliable. But we have a traitor General, Lets say G2 is traitor, G1 send message to G2 lets attach but\nG2 passed message G1 said not attack, so in this scenario we have faulty service or node is there \nin our Distributed system.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "All three armies are trying to attack city. the problem is all 3 have to attack together. So\nagain we need to figure out messanger mechanism that all 3 going to send messages to each \nother, This time messengers are all good. There is no problem with the messenger they are good and\nreliable. But we have a traitor General, Lets say G2 is traitor, G1 send message to G2 lets attach but\nG2 passed message G1 said not attack, so in this scenario we have faulty service or node is there \nin our Distributed system.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
