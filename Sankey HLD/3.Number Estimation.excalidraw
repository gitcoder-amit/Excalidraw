    },
    {
      "id": "zMFZhYkHnCuBXeWVgA7hp",
      "type": "text",
      "x": 1703.7553483576967,
      "y": 26452.60934159308,
      "width": 1111,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOM",
      "roundness": null,
      "seed": 32169545,
      "version": 816,
      "versionNonce": 1625402539,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788790259985,
      "link": null,
      "locked": false,
      "text": "We need common concesses from all services for order , maybe customer client service is faulty, lets\nsay it is sending wrong data to OMS and payments, CC will say payment is successful, but Payment will\nsay I have not received payment and OMS is now in confused state, this can happen may be wrong code\ndeployed to CC or there is some intermediate issue due to which this is happening\n\nIn actual system we try to ensure that atleast we dont landup in a situation, where we are not able\nto come into common concesses, and if that point comes where we have to draw concenssees, then there\nis dedicated concess algorithm that we are going to talk about later",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We need common concesses from all services for order , maybe customer client service is faulty, lets\nsay it is sending wrong data to OMS and payments, CC will say payment is successful, but Payment will\nsay I have not received payment and OMS is now in confused state, this can happen may be wrong code\ndeployed to CC or there is some intermediate issue due to which this is happening\n\nIn actual system we try to ensure that atleast we dont landup in a situation, where we are not able\nto come into common concesses, and if that point comes where we have to draw concenssees, then there\nis dedicated concess algorithm that we are going to talk about later",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "lBVKb1KQe4iJkc9delZv7",
