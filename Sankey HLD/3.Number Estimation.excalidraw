    {
      "id": "HQ8ckoYyeescKSU5i0Lnx",
      "type": "text",
      "x": 1690.4055946687313,
      "y": 23357.191904530275,
      "width": 1023,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNH",
      "roundness": null,
      "seed": 161326771,
      "version": 159,
      "versionNonce": 1745485157,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788790259984,
      "link": null,
      "locked": false,
      "text": "This is callecd No Common Knowledge Problem. Because only way is communication, the mechanism\nof communication is not reliable.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is callecd No Common Knowledge Problem. Because only way is communication, the mechanism\nof communication is not reliable.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "UsjTNriq0qDbryzlmm1ID",
      "type": "text",
      "x": 1675.7532509187313,
      "y": 23501.094248280275,
      "width": 1078,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNI",
      "roundness": null,
      "seed": 1466611443,
      "version": 1310,
      "versionNonce": 1940567915,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788790259984,
      "link": null,
      "locked": false,
      "text": "Lets say Army1 and Army2 are individual services, lets say service1 will only work if service2\nwill gives a response. And same service2 will only work if service1 will give response. Both are\nshould be like in kind of concensess. Like we are going to work if both are going to work. In that\ncase we are not have a reliable mechanism when both are able to coordinate to each other.\n\nLets say we have 2 service, order management service and payment service, order management will\nonly dispatch order if payment happens successfully, and lets say we charge a credit card if the\norder management service says that yes, we are ready to dispatch the order. now may be messages\nare lost in between, sometime both of them receive the message, they are like okay, but then its\na problem of acknowledgement also.\n\nThis is the problem of 2 generals, and too be honest there is not good any existing solution\nfor a 2 general problem, Only solution is having good retries and desigining our system in a\nway that we dont landup in a situation of this kind of situation like a deadlock.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lets say Army1 and Army2 are individual services, lets say service1 will only work if service2\nwill gives a response. And same service2 will only work if service1 will give response. Both are\nshould be like in kind of concensess. Like we are going to work if both are going to work. In that\ncase we are not have a reliable mechanism when both are able to coordinate to each other.\n\nLets say we have 2 service, order management service and payment service, order management will\nonly dispatch order if payment happens successfully, and lets say we charge a credit card if the\norder management service says that yes, we are ready to dispatch the order. now may be messages\nare lost in between, sometime both of them receive the message, they are like okay, but then its\na problem of acknowledgement also.\n\nThis is the problem of 2 generals, and too be honest there is not good any existing solution\nfor a 2 general problem, Only solution is having good retries and desigining our system in a\nway that we dont landup in a situation of this kind of situation like a deadlock.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "n0Z-PCj07veHliPJYunoU",
      "type": "text",
      "x": 1604.4095009187313,
      "y": 23934.195810780275,
      "width": 319,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNK",
      "roundness": null,
      "seed": 337040989,
      "version": 33,
      "versionNonce": 2064582853,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788790259984,
      "link": null,
      "locked": false,
      "text": "The Byzantine General Problem",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Byzantine General Problem",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "QLROcu_Ku2GYnhEFYu8qF",
      "type": "text",
      "x": 1659.4095009187313,
      "y": 23967.070810780275,
      "width": 1078,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNM",
      "roundness": null,
      "seed": 1999692563,
      "version": 239,
      "versionNonce": 1205244427,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788790259984,
      "link": null,
      "locked": false,
      "text": "this is kind of variation of 2 general problem. but for 2 general problem, communication mechanism\nwas faulty, but in this scenario we assume that messengers are all good, this time its more like\ntry party thing.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "this is kind of variation of 2 general problem. but for 2 general problem, communication mechanism\nwas faulty, but in this scenario we assume that messengers are all good, this time its more like\ntry party thing.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
