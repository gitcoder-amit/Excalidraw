    {
      "id": "ZRoaFRkdTZ0r4SBlDOrWh",
      "type": "text",
      "x": 3067.4233171076967,
      "y": 13541.89059159308,
      "width": 209,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
