    {
      "id": "q9AVnWcibRyhjbTnge3Oy",
      "type": "text",
      "x": 2076.5639421076967,
      "y": 13250.18746659308,
      "width": 1045,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIf",
      "roundness": null,
      "seed": 1538448912,
      "version": 435,
      "versionNonce": 477337104,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785771696680,
      "link": null,
      "locked": false,
      "text": "It is an identifier for any particular system that is connected to the network to be identified\nover the network.\nIn AWS there are few different options of IP address available\n\n1. IPv4 -> whenever we create a brand new instance, we will automatically see that to these EC2\n    instance there is some kind of public IPv4 address is attached",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It is an identifier for any particular system that is connected to the network to be identified\nover the network.\nIn AWS there are few different options of IP address available\n\n1. IPv4 -> whenever we create a brand new instance, we will automatically see that to these EC2\n    instance there is some kind of public IPv4 address is attached",
      "autoResize": true,
      "lineHeight": 1.25
    },
