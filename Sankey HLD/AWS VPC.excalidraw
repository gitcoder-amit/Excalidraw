    },
    {
      "id": "sR2ifT8OUwW-I5__gudbJ",
      "type": "text",
      "x": 2044.2709733576967,
      "y": 14539.89059159308,
      "width": 330,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJ3",
