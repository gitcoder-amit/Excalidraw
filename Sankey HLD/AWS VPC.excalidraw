      "seed": 1006880883,
      "version": 201,
      "versionNonce": 1872100221,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785857835463,
      "link": null,
      "locked": false,
      "text": "Our VPC will be able to partition into multiple subnets across diff availability zones, and one\nVPC is going to be available inside one Region.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our VPC will be able to partition into multiple subnets across diff availability zones, and one\nVPC is going to be available inside one Region.",
      "autoResize": true,
      "lineHeight": 1.25
    },
