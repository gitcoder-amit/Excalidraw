    {
      "id": "X6Lw5RlWG_ENk7LWhd4YW",
      "type": "text",
      "x": 1955.0678483576967,
      "y": 16507.84371659308,
      "width": 902,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
