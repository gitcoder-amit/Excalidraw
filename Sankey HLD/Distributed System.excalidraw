    {
      "id": "onhFLCzAsFOE0RgnlimPK",
      "type": "text",
      "x": 1818.9467546076967,
      "y": 22086.22262284308,
      "width": 297,
      "height": 175,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bLf",
      "roundness": null,
      "seed": 56505268,
      "version": 160,
      "versionNonce": 1017032477,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788269481891,
      "link": null,
      "locked": false,
      "text": "LB is capable of\nforwarding \ninternet traffic to\nmultiple EC2 instance.\nClient just need to know \nIP of LB.\nThis also do health Checks.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LB is capable of\nforwarding \ninternet traffic to\nmultiple EC2 instance.\nClient just need to know \nIP of LB.\nThis also do health Checks.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "h7UWm_YXn1qq4-Ynyf1wA",
      "type": "text",
      "x": 2111.4701921076967,
      "y": 22028.32027909308,
      "width": 55,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bLg",
      "roundness": null,
      "seed": 451698316,
      "version": 19,
      "versionNonce": 1698503987,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788269481891,
      "link": null,
      "locked": false,
      "text": "IP5\nof LB",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IP5\nof LB",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kFmyzJF8kPKptEXJOrx4T",
      "type": "text",
      "x": 1792.7084733576967,
      "y": 22331.49215409308,
      "width": 275,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bLi",
      "roundness": null,
      "seed": 1042464052,
      "version": 41,
      "versionNonce": 1855243133,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788269481891,
      "link": null,
      "locked": false,
      "text": "Type of Load Balanacer ->",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Type of Load Balanacer ->",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3Lf9NtZxewyzU-uWGziBk",
      "type": "text",
      "x": 1849.7045671076967,
      "y": 22372.15621659308,
      "width": 1012,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bLj",
      "roundness": null,
      "seed": 492864140,
      "version": 734,
      "versionNonce": 78184147,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788269481891,
      "link": null,
      "locked": false,
      "text": "1 Application LB -> L-7 -> this is going to work with our HTTP/S kind of Protocol\n2 Network LB -> L-4 -> this is going to work with TCP/UDP protocol \n3 Gateway LB ->\n4 Classic LB -> this is deprecated,\n\nAll of these comes under Elastic Load Balancer, Elastic Load Balancer is AWS managed\nLoad Balancer.\n\nWe can spin our manual EC2 that can work as a LB, we can write the Algo for balancing the\nload across our other EC2 instance. but that will going to take lot of effort from our side.\n\nIf we use ELB service, AWS manages the High availability, upgrades and maintenance of the\nLoad Balancer.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 Application LB -> L-7 -> this is going to work with our HTTP/S kind of Protocol\n2 Network LB -> L-4 -> this is going to work with TCP/UDP protocol \n3 Gateway LB ->\n4 Classic LB -> this is deprecated,\n\nAll of these comes under Elastic Load Balancer, Elastic Load Balancer is AWS managed\nLoad Balancer.\n\nWe can spin our manual EC2 that can work as a LB, we can write the Algo for balancing the\nload across our other EC2 instance. but that will going to take lot of effort from our side.\n\nIf we use ELB service, AWS manages the High availability, upgrades and maintenance of the\nLoad Balancer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wHOHlm6d6iEPU9AHOy4zd",
      "type": "text",
      "x": 1770.1381608576967,
      "y": 22820.92574784308,
      "width": 803,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bLk",
      "roundness": null,
      "seed": 13825588,
      "version": 243,
      "versionNonce": 898190301,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788269481891,
      "link": null,
      "locked": false,
      "text": "login to ubuntu machine -> ssh -i key.pem ubuntu@ip -> ssh to our machine\napt update(to update machine)\ninstall and setup python/nodejs acc to our requirement\nclone our project\nsetup project and run\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "login to ubuntu machine -> ssh -i key.pem ubuntu@ip -> ssh to our machine\napt update(to update machine)\ninstall and setup python/nodejs acc to our requirement\nclone our project\nsetup project and run\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
