    {
      "id": "o3y51C8bXYgqZtcVZAlwk",
      "type": "text",
      "x": -334.0015301548916,
      "y": 29625.80151523165,
      "width": 1100,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
