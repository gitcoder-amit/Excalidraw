    {
      "id": "OhJegN7aqNC2k_U2s5tpe",
      "type": "text",
      "x": 1621.5710435162848,
      "y": 30186.204778105275,
      "width": 440,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1H",
      "roundness": null,
      "seed": 201986230,
      "version": 606,
      "versionNonce": 1222761846,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780633431099,
      "link": null,
      "locked": false,
      "text": "If our processor picks the payload\nfrom queue but not able to process\ndue to xyz reason some validation\nissue or anything. We can retry,\nbut even if we are not able to\nprocess after retries then there is \na concept called as Deal letter queue.\nIts a secondary queue, in messaging\nsystem that store message that can't\nbe processed by the primary queue. this\nhappens due to incorrect format, network\nissues or system failure. The DLQ allows\nfor the further inspection and potential\nreprocessing of failed messages.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If our processor picks the payload\nfrom queue but not able to process\ndue to xyz reason some validation\nissue or anything. We can retry,\nbut even if we are not able to\nprocess after retries then there is \na concept called as Deal letter queue.\nIts a secondary queue, in messaging\nsystem that store message that can't\nbe processed by the primary queue. this\nhappens due to incorrect format, network\nissues or system failure. The DLQ allows\nfor the further inspection and potential\nreprocessing of failed messages.",
      "autoResize": true,
      "lineHeight": 1.25
    },
