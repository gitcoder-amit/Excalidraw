    {
      "id": "YnmW7Eg6KanqMbqoX7YnL",
      "type": "text",
      "x": -489.03320221963776,
      "y": 31623.31517656563,
      "width": 451,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
