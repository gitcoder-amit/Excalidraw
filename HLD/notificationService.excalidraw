      "index": "ag",
      "roundness": null,
      "seed": 1019920170,
      "version": 65,
      "versionNonce": 1963280694,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1780628399176,
      "link": null,
      "locked": false,
      "text": "                  Razorpay / Stripe\n                          |\n                          |\n                    Webhook Request\n                          |\n                          v\n                 Load Balancer\n                          |\n                          v\n                  Webhook API\n                          |\n         --------------------------------\n         | Verify Signature             |\n         | Verify Timestamp             |\n         | Deduplicate event_id         |\n         --------------------------------\n                          |\n                          v\n                 webhook_events\n                          |\n                    ACK 200 OK\n                          |\n                          v\n                       Kafka\n                          |\n                          v\n                 Payment Worker\n                          |\n          ---------------------------------\n          |                               |\n          v                               v\n       payments                    outbox_events\n                                          |\n                                          v\n                             Notification Worker\n                             Reconciliation Worker",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                  Razorpay / Stripe\n                          |\n                          |\n                    Webhook Request\n                          |\n                          v\n                 Load Balancer\n                          |\n                          v\n                  Webhook API\n                          |\n         --------------------------------\n         | Verify Signature             |\n         | Verify Timestamp             |\n         | Deduplicate event_id         |\n         --------------------------------\n                          |\n                          v\n                 webhook_events\n                          |\n                    ACK 200 OK\n                          |\n                          v\n                       Kafka\n                          |\n                          v\n                 Payment Worker\n                          |\n          ---------------------------------\n          |                               |\n          v                               v\n       payments                    outbox_events\n                                          |\n                                          v\n                             Notification Worker\n                             Reconciliation Worker",
      "autoResize": true,
      "lineHeight": 1.25
    },
