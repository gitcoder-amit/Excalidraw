      "boundElements": [],
      "updated": 1780629663546,
      "link": null,
      "locked": false,
      "text": "Lets say Booking service has its own\nnotification service, the problem with this\nis there are multiple component for whihc\nwe need to notify, lets say admin service\nhere we need to notify all the admins, for \nthat we need to again write notification\nlogic here or we need to call notification\nfrom the booking service that is not the\ngood way.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lets say Booking service has its own\nnotification service, the problem with this\nis there are multiple component for whihc\nwe need to notify, lets say admin service\nhere we need to notify all the admins, for \nthat we need to again write notification\nlogic here or we need to call notification\nfrom the booking service that is not the\ngood way.",
      "autoResize": true,
      "lineHeight": 1.25
