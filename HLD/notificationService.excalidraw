    {
      "id": "-4qWEzqEJSdDzNLs0rfLw",
      "type": "text",
      "x": 949.4613778622709,
      "y": 30739.74857523404,
      "width": 473,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b15",
      "roundness": null,
      "seed": 336268214,
      "version": 779,
      "versionNonce": 2131027830,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780632508264,
      "link": null,
      "locked": false,
      "text": "Each processor has its own\nlogic to handle.\nEmail processor knows that, it\nneed to communicate with some\nkind of SMTP server to send\nthat email, PN processor knowns\nthat it need to connect with\nFCM, These processors are going \nto have individual individual\ncode that is going to run. we\ncan have this as separate\nservice also, as this is not going\nto be very complex logic so we can\nhave them embedded in our notification\nservice.\nWhat they are goind to do lets say\nSMS queue has 5 payload, then SMS processor\nwill pick one by one and run the code.\nIf we need scale then we can increase \nour processor accordingly.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each processor has its own\nlogic to handle.\nEmail processor knows that, it\nneed to communicate with some\nkind of SMTP server to send\nthat email, PN processor knowns\nthat it need to connect with\nFCM, These processors are going \nto have individual individual\ncode that is going to run. we\ncan have this as separate\nservice also, as this is not going\nto be very complex logic so we can\nhave them embedded in our notification\nservice.\nWhat they are goind to do lets say\nSMS queue has 5 payload, then SMS processor\nwill pick one by one and run the code.\nIf we need scale then we can increase \nour processor accordingly.",
      "autoResize": true,
      "lineHeight": 1.25
    },
