    {
      "id": "kX2xev8e7iA2m3Q87t7bx",
      "type": "text",
      "x": 301.50084264539487,
      "y": 1259.2749545699708,
      "width": 902,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 1758230442,
      "version": 38,
      "versionNonce": 563352630,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1780628399176,
      "link": null,
      "locked": false,
      "text": "High-level architecture (components, data flow)\nDatabase schema (table names + key columns + indexes + constraints — not full DDL)\nHow you guarantee each of the 7 requirements\nFailure modes and how you recover\nOne thing you'd build later that you're consciously skipping for v1\n\nYou don't need to write code. I want a whiteboard-level design. \n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "High-level architecture (components, data flow)\nDatabase schema (table names + key columns + indexes + constraints — not full DDL)\nHow you guarantee each of the 7 requirements\nFailure modes and how you recover\nOne thing you'd build later that you're consciously skipping for v1\n\nYou don't need to write code. I want a whiteboard-level design. \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
