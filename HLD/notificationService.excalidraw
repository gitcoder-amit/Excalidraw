      "isDeleted": false,
      "boundElements": [],
      "updated": 1780628952853,
      "link": null,
      "locked": false,
      "text": "10 M -> 10^7 mails per day\n10^7/10^5 -> 10^2 -> 100 mails per second\nlets say in case of peak traffic -> 5 times the original traffic -> 500 mails per sec -> 500 queries\n     per sec(qps)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "10 M -> 10^7 mails per day\n10^7/10^5 -> 10^2 -> 100 mails per second\nlets say in case of peak traffic -> 5 times the original traffic -> 500 mails per sec -> 500 queries\n     per sec(qps)",
      "autoResize": true,
      "lineHeight": 1.25
    },
