      "index": "b0k",
      "roundness": null,
      "seed": 231216950,
      "version": 195,
      "versionNonce": 414230198,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780631246163,
      "link": null,
      "locked": false,
      "text": "According to diff diff type of notification we need to do some task, and we dont need to do immediately.\nthats where lot of concepts starts coming into the picture.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "According to diff diff type of notification we need to do some task, and we dont need to do immediately.\nthats where lot of concepts starts coming into the picture.",
      "autoResize": true,
      "lineHeight": 1.25
    },
