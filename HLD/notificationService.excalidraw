    {
      "id": "BloLvSkqGCaru1Xb2q4u8",
      "type": "text",
      "x": -311.538628766365,
      "y": 29273.58826303607,
      "width": 1131.415771484375,
      "height": 49.45823764322995,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 474852662,
      "version": 253,
      "versionNonce": 1290682154,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780628666780,
      "link": null,
      "locked": false,
      "text": "1. we want to build a mechanism through which diff diff type of notifications can be served to the user.\n2. 10 million emails per day lets say in terms of email notification",
      "fontSize": 19.78329505729198,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. we want to build a mechanism through which diff diff type of notifications can be served to the user.\n2. 10 million emails per day lets say in terms of email notification",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7gbj5-BOWmeKMSDQi1DYq",
      "type": "text",
      "x": -375.9084418698082,
      "y": 29395.508324916806,
      "width": 297,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 1215002474,
      "version": 117,
      "versionNonce": 731368054,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780628682078,
      "link": null,
      "locked": false,
      "text": "Non Functional Requirements",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non Functional Requirements",
      "autoResize": true,
