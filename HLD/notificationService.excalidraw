    {
      "id": "exYMLjuiooBjE3glfsao3",
      "type": "text",
      "x": 236.48219861821957,
      "y": 5432.183399312292,
      "width": 341,
      "height": 775,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 1062429622,
      "version": 113,
      "versionNonce": 1051125098,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1780628399176,
      "link": null,
      "locked": false,
      "text": "Purpose:\nAudit trail.\nInterviewers love audit tables.\n\nid\npayment_id\nevent_id\nold_state\nnew_state\nprocessed_at\n\n\nExample\n    pay_1\n\n    created\n        ↓\n    authorized\n    Store:\n\n        old_state = created\n        new_state = authorized\n    \n    Later:\n        authorized\n             ↓\n        captured\n\n    Store another row.\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Purpose:\nAudit trail.\nInterviewers love audit tables.\n\nid\npayment_id\nevent_id\nold_state\nnew_state\nprocessed_at\n\n\nExample\n    pay_1\n\n    created\n        ↓\n    authorized\n    Store:\n\n        old_state = created\n        new_state = authorized\n    \n    Later:\n        authorized\n             ↓\n        captured\n\n    Store another row.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
