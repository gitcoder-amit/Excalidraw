      "seed": 41290858,
      "version": 632,
      "versionNonce": 1397192118,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780630768398,
      "link": null,
      "locked": false,
      "text": "lets say we want to send email like\nhey prince please verify your emai\nor hey Amit please verify your email\nlike that, we want to configure our\nsubject and body accordingly, here\nit is the problem. May be we can send\nlist of bodies as well that is not\nthe scalable logic. So we need to handle\nthis in our Notificaation service. There\nare some template engine that provide\nus the capability of creating diff\ndiff template using dynamic values.\nwe can fill dynamic values and save that.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "lets say we want to send email like\nhey prince please verify your emai\nor hey Amit please verify your email\nlike that, we want to configure our\nsubject and body accordingly, here\nit is the problem. May be we can send\nlist of bodies as well that is not\nthe scalable logic. So we need to handle\nthis in our Notificaation service. There\nare some template engine that provide\nus the capability of creating diff\ndiff template using dynamic values.\nwe can fill dynamic values and save that.",
      "autoResize": true,
      "lineHeight": 1.25
    },
