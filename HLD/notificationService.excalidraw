      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "payment_id (PK)\nmerchant_id\namount\ncurrent_state\ncreated_at\nupdated_at\n\n\nExample:\n    payment_id = pay_1\n    current_state = captured\n\nIndex\n    PRIMARY KEY(payment_id)\n    INDEX(merchant_id)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
