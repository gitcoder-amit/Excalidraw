    {
      "id": "5PyR1aQQ9FSSeS-ZLsU2l",
      "type": "text",
      "x": -651.2167146486058,
      "y": 32585.06644599998,
      "width": 440,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
