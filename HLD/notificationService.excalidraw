      "isDeleted": false,
      "boundElements": [],
      "updated": 1780631183855,
      "link": null,
      "locked": false,
      "text": "-> post /api/v1/notifications/push-notification\n{\n    mechanism of push notification is\n    embedded inside the Operating system\n    of the mobile. Android has something\n    called as Firebase cloud messaging.\n    Using FCM we can send the push noti\n    fication to the corresponding user.\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> post /api/v1/notifications/push-notification\n{\n    mechanism of push notification is\n    embedded inside the Operating system\n    of the mobile. Android has something\n    called as Firebase cloud messaging.\n    Using FCM we can send the push noti\n    fication to the corresponding user.\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xkDpnoYXdxBskjHloR1Cj",
      "type": "text",
      "x": -642.0651338204204,
