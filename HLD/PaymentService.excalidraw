      "updated": 1780619196700,
      "link": null,
      "locked": false,
      "text": "POST /webhooks/payments\nHeaders:\n  X-Partner-Signature: <hex hmac-sha256>\n  X-Partner-Timestamp: 1730000000\nBody:\n{\n  \"event_id\": \"evt_8a7f3b2c1d\",\n  \"event_type\": \"payment.captured\",\n  \"created_at\": \"2026-05-04T10:23:11Z\",\n  \"payment\": {\n    \"payment_id\": \"pay_x9k2m\",\n    \"merchant_id\": \"mer_42\",\n    \"amount\": 150000,\n    \"status\": \"captured\"\n  }\n}\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /webhooks/payments\nHeaders:\n  X-Partner-Signature: <hex hmac-sha256>\n  X-Partner-Timestamp: 1730000000\nBody:\n{\n  \"event_id\": \"evt_8a7f3b2c1d\",\n  \"event_type\": \"payment.captured\",\n  \"created_at\": \"2026-05-04T10:23:11Z\",\n  \"payment\": {\n    \"payment_id\": \"pay_x9k2m\",\n    \"merchant_id\": \"mer_42\",\n    \"amount\": 150000,\n    \"status\": \"captured\"\n  }\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
