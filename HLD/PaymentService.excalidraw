    },
    {
      "id": "-FgVRbohXI_0sES08tOTI",
      "type": "text",
      "x": -336.14467830153006,
      "y": 25647.070512607337,
      "width": 646.7998046875,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
