      "updated": 1780620258218,
      "link": null,
      "locked": false,
      "text": "payment_id (PK)\nmerchant_id\namount\ncurrent_state\ncreated_at\nupdated_at\n\n\nExample:\n    payment_id = pay_1\n    current_state = captured\n\nIndex\n    PRIMARY KEY(payment_id)\n    INDEX(merchant_id)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "payment_id (PK)\nmerchant_id\namount\ncurrent_state\ncreated_at\nupdated_at\n\n\nExample:\n    payment_id = pay_1\n    current_state = captured\n\nIndex\n    PRIMARY KEY(payment_id)\n    INDEX(merchant_id)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "srBOTrzxg49K4VAl_56wD",
      "type": "text",
