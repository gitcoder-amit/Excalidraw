    },
    {
      "id": "XY1abLdAHxLn1_nsupnsT",
      "type": "text",
      "x": 1987.8334733576967,
      "y": 22610.77340409308,
      "width": 198,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIs",
      "roundness": null,
      "seed": 1444641075,
      "version": 3,
      "versionNonce": 1432291443,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785425110990,
      "link": null,
      "locked": false,
      "text": "Q1. What is PID 1?",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q1. What is PID 1?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "c6rXGR__F-Fxj1Y5nRx00",
      "type": "text",
      "x": 2029.8334733576967,
      "y": 22637.77340409308,
      "width": 1133,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIt",
      "roundness": null,
      "seed": 2143344989,
      "version": 5,
      "versionNonce": 745632765,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785425125984,
      "link": null,
      "locked": false,
      "text": "PID 1 is the first user-space process started by the Linux kernel. On most modern Linux distributions, \nit is systemd, which is responsible for initializing the system and managing services.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PID 1 is the first user-space process started by the Linux kernel. On most modern Linux distributions, \nit is systemd, which is responsible for initializing the system and managing services.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qAN9L1e-LHFxYfDAzhiCe",
      "type": "text",
      "x": 1987.8334733576967,
      "y": 22734.77340409308,
      "width": 396,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIu",
      "roundness": null,
      "seed": 2134398429,
      "version": 4,
      "versionNonce": 1508894461,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785425134679,
      "link": null,
      "locked": false,
      "text": "Q2. What happens if systemd crashes?",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q2. What happens if systemd crashes?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0KSPAAxdrTZvLm0p6sNbu",
      "type": "text",
      "x": 2025.8334733576967,
      "y": 22764.77340409308,
      "width": 1067,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIv",
      "roundness": null,
      "seed": 502042675,
      "version": 8,
      "versionNonce": 835540883,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785425156358,
      "link": null,
      "locked": false,
      "text": "Since PID 1 has a special role, if it exits unexpectedly, the system generally cannot continue \noperating normally and will typically panic or require a reboot. That's why it is designed to be \nhighly reliable.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Since PID 1 has a special role, if it exits unexpectedly, the system generally cannot continue \noperating normally and will typically panic or require a reboot. That's why it is designed to be \nhighly reliable.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AflLYVHoj5aoBQCJedOCx",
      "type": "text",
      "x": 1989.8334733576967,
      "y": 22895.77340409308,
      "width": 748,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIw",
      "roundness": null,
      "seed": 1824585789,
      "version": 4,
      "versionNonce": 1671112029,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785425163911,
      "link": null,
      "locked": false,
      "text": "Q3. Why do we use systemd instead of starting applications manually?",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q3. Why do we use systemd instead of starting applications manually?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eQio-wIJK7eLpukdbCgPj",
      "type": "text",
      "x": 2027.8334733576967,
      "y": 22927.77340409308,
      "width": 770,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIx",
      "roundness": null,
      "seed": 992644051,
      "version": 4,
      "versionNonce": 1620580531,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785425174430,
      "link": null,
      "locked": false,
      "text": "Because it can:\n\nStart services automatically at boot.\nRestart services if they crash.\nManage service dependencies.\nCentralize logging.\nProvide a consistent way to start, stop, reload, and monitor services.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Because it can:\n\nStart services automatically at boot.\nRestart services if they crash.\nManage service dependencies.\nCentralize logging.\nProvide a consistent way to start, stop, reload, and monitor services.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
