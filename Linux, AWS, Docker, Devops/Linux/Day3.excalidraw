      "type": "text",
      "x": 1972.5639421076967,
      "y": 17118.77340409308,
      "width": 791.2079467773438,
      "height": 299.83333333333337,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
