    {
      "id": "wroPqyt3L8DmsYC--qN9V",
      "type": "text",
      "x": 1947.8334733576967,
      "y": 15771.77340409308,
      "width": 275,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
