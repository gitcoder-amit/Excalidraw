      "seed": 331274429,
      "version": 11,
      "versionNonce": 178229853,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785423617938,
      "link": null,
      "locked": false,
      "text": "systemd (PID 1)\n│\n├── sshd\n│     │\n│     └── bash\n│            │\n│            └── python app.py\n│\n└── nginx\n\n\nEvery process (except the first one started by the kernel) has a parent.",
      "fontSize": 19.98888888888889,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "systemd (PID 1)\n│\n├── sshd\n│     │\n│     └── bash\n│            │\n│            └── python app.py\n│\n└── nginx\n\n\nEvery process (except the first one started by the kernel) has a parent.",
      "autoResize": true,
      "lineHeight": 1.25
    },
