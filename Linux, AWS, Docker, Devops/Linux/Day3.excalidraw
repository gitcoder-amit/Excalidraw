    {
      "id": "FxqGeiN19zqVXRG0Iph4W",
      "type": "text",
      "x": 2021.7084733576967,
      "y": 10968.52731034308,
      "width": 726,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
