    {
      "id": "Rtc43j5SWb2OR3xjdp0wK",
      "type": "text",
      "x": 1885.4076921076967,
      "y": 3331.749966593081,
      "width": 825,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGT",
      "roundness": null,
      "seed": 1637843340,
      "version": 333,
      "versionNonce": 1263150132,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785166184655,
      "link": null,
      "locked": false,
      "text": "pwd -> present working directory\nls -> list files\nls -l -> Long listing format.\n    \n    Notice:\n        Permissions\n        Owner\n        Group\n        File size\n        Modification time\n        \n        We'll study these in detail tomorrow.\n\nls -a -> Hidden files begin with a . -> Example -> .bashrc , .git, .profile\n\ncd / -> go to the root directory\n\nmkdir <dir_name> <dir_name2> -> for creating directory\ntouch <file_name> -> for creating empty file\ncat <file_name> -> for reading file\n\necho \"Linux uses a single root directory /\" > day1_notes.txt\necho \"The shell interprets commands.\" >> day1_notes.txt\n\nNotice the difference:\n\n> creates or overwrites a file.\n>> appends to an existing file.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "pwd -> present working directory\nls -> list files\nls -l -> Long listing format.\n    \n    Notice:\n        Permissions\n        Owner\n        Group\n        File size\n        Modification time\n        \n        We'll study these in detail tomorrow.\n\nls -a -> Hidden files begin with a . -> Example -> .bashrc , .git, .profile\n\ncd / -> go to the root directory\n\nmkdir <dir_name> <dir_name2> -> for creating directory\ntouch <file_name> -> for creating empty file\ncat <file_name> -> for reading file\n\necho \"Linux uses a single root directory /\" > day1_notes.txt\necho \"The shell interprets commands.\" >> day1_notes.txt\n\nNotice the difference:\n\n> creates or overwrites a file.\n>> appends to an existing file.",
      "autoResize": true,
      "lineHeight": 1.25
    },
