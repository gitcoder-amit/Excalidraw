    {
      "id": "aAdNOC1M-YsOR1F40tDee",
      "type": "text",
      "x": 1793.9272233576967,
      "y": 4487.242154093081,
      "width": 242,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
