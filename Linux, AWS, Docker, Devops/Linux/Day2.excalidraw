    {
      "id": "4Doo1NTsi3MZc729--zQq",
      "type": "text",
      "x": 2269.6811296076967,
      "y": 2585.890591593081,
      "width": 165,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
