      "isDeleted": true,
      "boundElements": [],
      "updated": 1785344449486,
      "link": null,
      "locked": false,
      "text": "You might think:",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
