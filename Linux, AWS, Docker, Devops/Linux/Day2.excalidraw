    {
      "id": "kSYbFpsTw7lxzLWiGznm0",
      "type": "text",
      "x": 1693.9272233576967,
      "y": 7101.242154093081,
      "width": 1023,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
