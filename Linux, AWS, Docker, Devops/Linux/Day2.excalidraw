      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGv",
      "roundness": null,
      "seed": 1220099536,
      "version": 157,
      "versionNonce": 1241889584,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785345119786,
      "link": null,
      "locked": false,
      "text": "This is one of the most misunderstood Linux concepts.\n\nQuestion -> Suppose you create \n    touch resume.pdf\n\nWhat does Linux store? \nMost people answer:\n    resume.pdf -> data\n    this is wrong\n\nInternally Linux stores\n    Filename ->  Inode ->  Disk Blocks -> Actual Data",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is one of the most misunderstood Linux concepts.\n\nQuestion -> Suppose you create \n    touch resume.pdf\n\nWhat does Linux store? \nMost people answer:\n    resume.pdf -> data\n    this is wrong\n\nInternally Linux stores\n    Filename ->  Inode ->  Disk Blocks -> Actual Data",
      "autoResize": true,
      "lineHeight": 1.25
    },
