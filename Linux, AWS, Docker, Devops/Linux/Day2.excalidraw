    {
      "id": "TUnmdKR3yPzT13pp1cSGu",
      "type": "text",
      "x": 1908.4272233576967,
      "y": 3635.242154093081,
      "width": 187,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
