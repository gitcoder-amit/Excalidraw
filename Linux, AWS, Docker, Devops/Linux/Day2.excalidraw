      "updated": 1785345836047,
      "link": null,
      "locked": false,
      "text": "Soft Links (Symbolic Links) ->",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Soft Links (Symbolic Links) ->",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IApwoONWqYIMTuSYuhf0w",
      "type": "text",
      "x": 1866.5444108576967,
      "y": 7000.871060343081,
      "width": 770,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH6",
      "roundness": null,
      "seed": 505796912,
      "version": 60,
      "versionNonce": 27222992,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785345935653,
      "link": null,
      "locked": false,
      "text": "Now create\n    ln -s notes.txt shortcut.txt\nCheck\n    ls -l\n    You'll see\n    shortcut.txt -> notes.txt\n    A symbolic link points to the filename, not directly to the inode.\n    Visual: \n        shortcut.txt -> notes.txt ->  inode -> data",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now create\n    ln -s notes.txt shortcut.txt\nCheck\n    ls -l\n    You'll see\n    shortcut.txt -> notes.txt\n    A symbolic link points to the filename, not directly to the inode.\n    Visual: \n        shortcut.txt -> notes.txt ->  inode -> data",
      "autoResize": true,
      "lineHeight": 1.25
    },
