    {
      "id": "4xU5dvgNU4H6zN4-4ugKE",
      "type": "text",
      "x": 1877.5483171076967,
      "y": 2039.484341593081,
      "width": 649,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGn",
      "roundness": null,
      "seed": 573118768,
      "version": 19,
      "versionNonce": 1379657008,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785344661537,
      "link": null,
      "locked": false,
      "text": "Starts from the root directory (/).\nExample:\n    /home/amit/projects/docker/app.py\n\nIt always starts with /.\nNo matter where you are, this path points to the same file.\nThink of it like a complete postal address.\nHouse No. 21, MG Road, Bengaluru, Karnataka, India\nNo ambiguity.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Starts from the root directory (/).\nExample:\n    /home/amit/projects/docker/app.py\n\nIt always starts with /.\nNo matter where you are, this path points to the same file.\nThink of it like a complete postal address.\nHouse No. 21, MG Road, Bengaluru, Karnataka, India\nNo ambiguity.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hgTSHVkvr4WVbpTWXJJMk",
      "type": "text",
      "x": 1848.4272233576967,
      "y": 2308.242154093081,
      "width": 187,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGo",
      "roundness": null,
      "seed": 84259632,
      "version": 8,
      "versionNonce": 379470288,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785344673744,
      "link": null,
      "locked": false,
      "text": "Relative Path -> ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Relative Path -> ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Yhf6WCliinpCOzprMVy4v",
      "type": "text",
      "x": 1891.7944108576967,
      "y": 2335.234341593081,
      "width": 913,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGp",
      "roundness": null,
      "seed": 210883536,
      "version": 136,
      "versionNonce": 1001996240,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785344827063,
      "link": null,
      "locked": false,
      "text": "Relative paths depend on your current location.\nCurrent directory:\n    /home/amit/projects\n\nNow you type\n    cd docker\n\nWhy did it work?\nBecause Linux understood\n    /home/amit/projects/docker\n\nYou omitted the beginning because Linux starts from your current working directory.\n\nSpecial Relative Paths ->\n    Current directory -> .\n    parent directory -> ..\n    home Directory -> ~\n\npwd -> /home/amit/projects/docker\ncd .. -> /home/amit/projects",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Relative paths depend on your current location.\nCurrent directory:\n    /home/amit/projects\n\nNow you type\n    cd docker\n\nWhy did it work?\nBecause Linux understood\n    /home/amit/projects/docker\n\nYou omitted the beginning because Linux starts from your current working directory.\n\nSpecial Relative Paths ->\n    Current directory -> .\n    parent directory -> ..\n    home Directory -> ~\n\npwd -> /home/amit/projects/docker\ncd .. -> /home/amit/projects",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "u7JfzcHywVJ5ycr-y_TeN",
      "type": "text",
      "x": 1843.5483171076967,
      "y": 2908.117154093081,
      "width": 528,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
