    {
      "id": "F7e0Dmrv9_9gNHnyx99fR",
      "type": "text",
      "x": 1875.2865983576967,
      "y": 6040.007779093081,
      "width": 517,
      "height": 875,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH2",
      "roundness": null,
      "seed": 1665108944,
      "version": 117,
      "versionNonce": 984205264,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785345791824,
      "link": null,
      "locked": false,
      "text": "Create -> \n    echo \"Hello Linux\" > notes.txt\nCheck inode ->\n    ls -i\n    84215 notes.txt\n\nNow create\n    ln notes.txt backup.txt\nCheck again\n    ls -i\n    84215 notes.txt\n    84215 backup.txt\n    Same inode.\n    That means\n    They are the same file.\n    Not copies.\n\n    notes.txt\n          │\n          ▼\n    inode 84215\n          ▲\n          │\n    backup.txt\n\nTest It\n\nEdit one file\n    echo \"Docker\" >> notes.txt\nNow\n    cat backup.txt\nOutput\n    Hello Linux\n    Docker\nBecause both filenames point to the same inode.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Create -> \n    echo \"Hello Linux\" > notes.txt\nCheck inode ->\n    ls -i\n    84215 notes.txt\n\nNow create\n    ln notes.txt backup.txt\nCheck again\n    ls -i\n    84215 notes.txt\n    84215 backup.txt\n    Same inode.\n    That means\n    They are the same file.\n    Not copies.\n\n    notes.txt\n          │\n          ▼\n    inode 84215\n          ▲\n          │\n    backup.txt\n\nTest It\n\nEdit one file\n    echo \"Docker\" >> notes.txt\nNow\n    cat backup.txt\nOutput\n    Hello Linux\n    Docker\nBecause both filenames point to the same inode.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uEchN_KpcWUVc8vkujaKN",
      "type": "text",
      "x": 1814.1694108576967,
      "y": 5932.199185343081,
      "width": 836,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH3",
      "roundness": null,
      "seed": 1189204272,
      "version": 191,
      "versionNonce": 1184684496,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785347008033,
      "link": null,
      "locked": false,
      "text": "Hard Links\n    The ln command is used to create links between files.\n    syntax -> ln <existing_file> <new_link_name> -> this creates a hard link\n    For a symbolic (soft) link: ln -s notes.txt shortcut.txt",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hard Links\n    The ln command is used to create links between files.\n    syntax -> ln <existing_file> <new_link_name> -> this creates a hard link\n    For a symbolic (soft) link: ln -s notes.txt shortcut.txt",
      "autoResize": true,
      "lineHeight": 1.25
    },
