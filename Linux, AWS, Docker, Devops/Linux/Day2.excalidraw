    },
    {
      "id": "B1yiOZ5n9_eJsiRkcaXBT",
      "type": "text",
      "x": 1828.4272233576967,
      "y": 8472.62887284308,
      "width": 1012,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHF",
      "roundness": null,
      "seed": 1217330640,
      "version": 25,
      "versionNonce": 1423280944,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785346355337,
      "link": null,
      "locked": false,
      "text": "Suppose\n    application.log -> is being written by Django.\nYou delete\n    rm application.log\n\nWhy doesn't disk space immediately decrease?\nBecause the Django process still has the file open.\nThe directory entry is gone, but the inode remains in use until the process closes the file.\nThis is a real production issue and a common interview question.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Suppose\n    application.log -> is being written by Django.\nYou delete\n    rm application.log\n\nWhy doesn't disk space immediately decrease?\nBecause the Django process still has the file open.\nThe directory entry is gone, but the inode remains in use until the process closes the file.\nThis is a real production issue and a common interview question.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3LnowJCUbnsfeJPD2wHQz",
      "type": "text",
      "x": 2047.4272233576967,
      "y": 8467.24215409308,
      "width": 11,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
