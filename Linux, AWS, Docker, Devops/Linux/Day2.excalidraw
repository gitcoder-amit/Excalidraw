    {
      "id": "dCnFDRHWtNq6b9VPlsHa_",
      "type": "text",
      "x": 1879.8530046076967,
      "y": -365.8906584069191,
      "width": 1199,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
