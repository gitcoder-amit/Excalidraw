    },
    {
      "id": "8n305D4KZFnSirEiTQWsA",
      "type": "text",
      "x": 1872.6576921076967,
      "y": 1471.390591593081,
      "width": 858,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGk",
      "roundness": null,
      "seed": 768462128,
      "version": 126,
      "versionNonce": 1418305328,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785344927374,
      "link": null,
      "locked": false,
      "text": "Today you'll learn concepts that explain:\n\nWhy Docker volumes work.\nWhy Kubernetes Persistent Volumes exist.\nWhy deleting a file sometimes doesn't free disk space.\nWhy Linux can have two filenames for the same file.\nHow permissions actually work.\n\nThese are interview topics for backend engineers with 2–8 years of experience.\n\n\n| Time   | Topic                          |\n| ------ | ------------------------------ |\n| 10 min | Absolute vs Relative Path      |\n| 20 min | Inodes (Very Important)        |\n| 15 min | Hard Link vs Soft Link         |\n| 15 min | Hands-on + Interview Questions |\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Today you'll learn concepts that explain:\n\nWhy Docker volumes work.\nWhy Kubernetes Persistent Volumes exist.\nWhy deleting a file sometimes doesn't free disk space.\nWhy Linux can have two filenames for the same file.\nHow permissions actually work.\n\nThese are interview topics for backend engineers with 2–8 years of experience.\n\n\n| Time   | Topic                          |\n| ------ | ------------------------------ |\n| 10 min | Absolute vs Relative Path      |\n| 20 min | Inodes (Very Important)        |\n| 15 min | Hard Link vs Soft Link         |\n| 15 min | Hands-on + Interview Questions |\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
