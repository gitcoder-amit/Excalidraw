    {
      "id": "oSMmiH7nv-FX3JnRBTyKK",
      "type": "text",
      "x": 1892.6928483576967,
      "y": 2931.234341593081,
      "width": 748,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGs",
      "roundness": null,
      "seed": 1008726480,
      "version": 44,
      "versionNonce": 1978824496,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785344895198,
      "link": null,
      "locked": false,
      "text": "Because scripts should not depend on the current working directory.\n\nExample ->\nBad -> \n    python app.py\nGood ->\n    python /opt/myapp/app.py\n\nThe second command works regardless of where the script is executed.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Because scripts should not depend on the current working directory.\n\nExample ->\nBad -> \n    python app.py\nGood ->\n    python /opt/myapp/app.py\n\nThe second command works regardless of where the script is executed.",
      "autoResize": true,
      "lineHeight": 1.25
    },
