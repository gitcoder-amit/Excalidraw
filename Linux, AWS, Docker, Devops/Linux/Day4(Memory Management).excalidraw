    },
    {
      "id": "GGsPqy_3X9Z37GxbgRakF",
      "type": "text",
      "x": 648.5637146898734,
      "y": 13182.399331063432,
      "width": 187,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
