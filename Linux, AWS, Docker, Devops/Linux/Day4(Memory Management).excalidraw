    {
      "id": "I4oU3Vxp3T9mcioxWv23V",
      "type": "text",
      "x": 514.1613709398734,
      "y": 34625.34464356343,
      "width": 165,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
