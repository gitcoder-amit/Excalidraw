    {
      "id": "SDP73MQSHZklx2iwN3JGL",
      "type": "text",
      "x": 654.5637146898734,
      "y": 12415.399331063432,
      "width": 88,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
