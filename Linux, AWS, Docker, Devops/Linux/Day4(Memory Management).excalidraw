    },
    {
      "id": "hyNSW5OBg9KcRJqjxUbVs",
      "type": "text",
      "x": 784.5637146898734,
      "y": 5679.399331063432,
      "width": 165,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4e",
