      "isDeleted": true,
      "boundElements": [],
      "updated": 1788288733999,
      "link": null,
      "locked": false,
      "text": "Difference Between ps, ps -ef, and ps aux",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Difference Between ps, ps -ef, and ps aux",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jeeY6NKT0rNZm4psUs86P",
      "type": "text",
      "x": 759.0637146898734,
      "y": 15093.899331063432,
      "width": 979,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4Y",
      "roundness": null,
      "seed": 1158461942,
      "version": 39,
      "versionNonce": 686935333,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788288733999,
      "link": null,
      "locked": false,
      "text": "| Command  | Shows                                                                      |\n| -------- | -------------------------------------------------------------------------- |\n| `ps`     | Processes attached to the current terminal                                 |\n| `ps -ef` | All system processes in full format                                        |\n| `ps aux` | All system processes with additional information like CPU and memory usage |\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| Command  | Shows                                                                      |\n| -------- | -------------------------------------------------------------------------- |\n| `ps`     | Processes attached to the current terminal                                 |\n| `ps -ef` | All system processes in full format                                        |\n| `ps aux` | All system processes with additional information like CPU and memory usage |\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
