    {
      "id": "4gPgrS3_47gEdv6GVoEdt",
      "type": "text",
      "x": 1678.313188025786,
      "y": 75876.00308129916,
      "width": 1122,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bmc",
      "roundness": null,
      "seed": 1737524616,
      "version": 854,
      "versionNonce": 121338337,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778897252918,
      "link": null,
      "locked": false,
      "text": "since https protocol is stateless,so it will not remember anything for new request after one response\nconnection will be break, server will not remember us, Now lets say I need\nchat of Anjali, how we will get that, we need to ask to the server and server will give that, for that\nagain we need to send username and password as server doesn't know who we are.\nSo here user experience is very bad as he need to put username and password again and again, manual\nor automatic but this is not the good way. like for one things we need to send usename and password \nagain and again. To improve that we can create session of that so session authentication.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "since https protocol is stateless,so it will not remember anything for new request after one response\nconnection will be break, server will not remember us, Now lets say I need\nchat of Anjali, how we will get that, we need to ask to the server and server will give that, for that\nagain we need to send username and password as server doesn't know who we are.\nSo here user experience is very bad as he need to put username and password again and again, manual\nor automatic but this is not the good way. like for one things we need to send usename and password \nagain and again. To improve that we can create session of that so session authentication.",
      "autoResize": true,
      "lineHeight": 1.25
    },
