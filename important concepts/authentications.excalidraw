    {
      "id": "Tn9L8i00xl60w44j5XPNK",
      "type": "text",
      "x": 2210.8368543026545,
      "y": 76628.9795319643,
      "width": 451,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
