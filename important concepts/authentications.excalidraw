      "index": "bmz",
      "roundness": null,
      "seed": 1611896193,
      "version": 809,
      "versionNonce": 835572175,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778898445180,
      "link": null,
      "locked": false,
      "text": "server will create session id\nstore that into database with \nvalidity time\nand send to client, from next\ntime client need to send\nit to the server, no need to\nsend username and password.\nand server will check that session\nid is preesent and valie in my database\nif yes you are loged in\n\nthis session id used by bank servers more\nbut this is also not a good solution as\ninstagram server need to hit db again and\nagain to check the session id.\n\nSo to next version tokens with the help \nof that we dont need to hit db again\nand again to verify the user.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "server will create session id\nstore that into database with \nvalidity time\nand send to client, from next\ntime client need to send\nit to the server, no need to\nsend username and password.\nand server will check that session\nid is preesent and valie in my database\nif yes you are loged in\n\nthis session id used by bank servers more\nbut this is also not a good solution as\ninstagram server need to hit db again and\nagain to check the session id.\n\nSo to next version tokens with the help \nof that we dont need to hit db again\nand again to verify the user.",
      "autoResize": true,
      "lineHeight": 1.25
    },
