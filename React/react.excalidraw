    },
    {
      "id": "9UjIy1PYpmt8gxmtFdilH",
      "type": "text",
      "x": 1278.8471345411454,
      "y": 91481.16200969061,
      "width": 825,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bro",
      "roundness": null,
      "seed": 181153194,
      "version": 105,
      "versionNonce": 802562154,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780369717507,
      "link": null,
      "locked": false,
      "text": "const [counter, setCounter] = useState(0)\nuseEffect(()=>{\n        console.log('only once');\n    }, [counter]) -> this will execute everytime counter state will change.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const [counter, setCounter] = useState(0)\nuseEffect(()=>{\n        console.log('only once');\n    }, [counter]) -> this will execute everytime counter state will change.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nUWFIED1nnFAhjt5SiM_z",
      "type": "text",
      "x": 1233.3588532911454,
      "y": 91673.67372844061,
      "width": 517,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brp",
