    },
    {
      "id": "oTVrr_C5IR9-nT8TvwMjx",
      "type": "text",
      "x": 1396.8744782911454,
      "y": 84323.70107219061,
      "width": 1089,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bqw",
      "roundness": null,
      "seed": 379149878,
      "version": 576,
      "versionNonce": 1614727466,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780364053385,
      "link": null,
      "locked": false,
      "text": "Here the code that we are writing is not pure Javascript, it is JSX, inside this it has HTML, due\nto that we need to do conversion with the help of babel, Bable is a transcompiler which convert jsx\ncode to javascript and html, but one problem with babel is if it gets any component with its first\nletter as small then it will understand it is html tag, and if it gets first letter as capital then\nit understand it is react component and babel will convert this in javascript.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here the code that we are writing is not pure Javascript, it is JSX, inside this it has HTML, due\nto that we need to do conversion with the help of babel, Bable is a transcompiler which convert jsx\ncode to javascript and html, but one problem with babel is if it gets any component with its first\nletter as small then it will understand it is html tag, and if it gets first letter as capital then\nit understand it is react component and babel will convert this in javascript.",
      "autoResize": true,
      "lineHeight": 1.25
    },
