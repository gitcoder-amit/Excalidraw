      "seed": 1229015274,
      "version": 11,
      "versionNonce": 2052452790,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780369768955,
      "link": null,
      "locked": false,
      "text": "3. What is dependency params in useEffect hook?",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. What is dependency params in useEffect hook?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OHD6Y4Ezrg9eG6liKL63A",
      "type": "text",
      "x": 1271.7143220411454,
      "y": 91715.86904094061,
      "width": 979,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brq",
      "roundness": null,
      "seed": 1484556138,
      "version": 121,
      "versionNonce": 1608150122,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780369843959,
      "link": null,
      "locked": false,
      "text": "\nthree cases\n\n\nconst [counter, setCounter] = useState(0)\nuseEffect(()=>{\n        console.log('only once');\n    }) -> this will execute everytime component change.\n\n\nconst [counter, setCounter] = useState(0)\nuseEffect(()=>{\n        console.log('only once');\n    }, []) -> this will execute one time when initial rendering will happen.\n\n\nconst [counter, setCounter] = useState(0)\nuseEffect(()=>{\n        console.log('only once');\n    }, [counter, data]) -> this will execute everytime counter or data state will change.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nthree cases\n\n\nconst [counter, setCounter] = useState(0)\nuseEffect(()=>{\n        console.log('only once');\n    }) -> this will execute everytime component change.\n\n\nconst [counter, setCounter] = useState(0)\nuseEffect(()=>{\n        console.log('only once');\n    }, []) -> this will execute one time when initial rendering will happen.\n\n\nconst [counter, setCounter] = useState(0)\nuseEffect(()=>{\n        console.log('only once');\n    }, [counter, data]) -> this will execute everytime counter or data state will change.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SGbnaSQ5z9lybvBDr6Mur",
