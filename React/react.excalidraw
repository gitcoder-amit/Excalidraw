      "isDeleted": false,
      "boundElements": [],
      "updated": 1780373878341,
      "link": null,
      "locked": false,
      "text": "const person = {\"name\": \"Amit\", \"age\": 25, \"city\": \"New York\"};\n\n1 -> fetch age from person using destructuring\nconst {age} = person;\n\n2 assign default value or fetch value that is not present\nconst {age, email = \"not provided\"} = person;\n\nconsole.log(age);\nconsole.log(email); \n\n\n3 Name change using destructuring\n\nconst age = 31;\nconst {age: person_age} = person;\nconsole.log(person_age). # 25",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const person = {\"name\": \"Amit\", \"age\": 25, \"city\": \"New York\"};\n\n1 -> fetch age from person using destructuring\nconst {age} = person;\n\n2 assign default value or fetch value that is not present\nconst {age, email = \"not provided\"} = person;\n\nconsole.log(age);\nconsole.log(email); \n\n\n3 Name change using destructuring\n\nconst age = 31;\nconst {age: person_age} = person;\nconsole.log(person_age). # 25",
      "autoResize": true,
      "lineHeight": 1.25
    },
