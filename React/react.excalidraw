      "updated": 1780372855945,
      "link": null,
      "locked": false,
      "text": "import React from \"react\";\nimport { useState, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport { useRef } from \"react\";\n\nconst Home = () => {\n    const { params } = useParams();\n    const inputRef = useRef();\n\n    console.log(params);\n    return (\n        <div>\n            <input type=\"text\" placeholder=\"Enter your name\" ref={inputRef} />\n            <button onClick={() => inputRef.current.focus()}>Submit</button>\n        </div>\n    )\n}\n\nexport default Home;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import React from \"react\";\nimport { useState, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport { useRef } from \"react\";\n\nconst Home = () => {\n    const { params } = useParams();\n    const inputRef = useRef();\n\n    console.log(params);\n    return (\n        <div>\n            <input type=\"text\" placeholder=\"Enter your name\" ref={inputRef} />\n            <button onClick={() => inputRef.current.focus()}>Submit</button>\n        </div>\n    )\n}\n\nexport default Home;",
      "autoResize": true,
      "lineHeight": 1.25
    },
