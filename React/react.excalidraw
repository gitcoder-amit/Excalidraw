    {
      "id": "k-yydM4D2-MYzqKyk6Mvf",
      "type": "text",
      "x": 1112.4018220411454,
      "y": 96648.25575969061,
      "width": 803,
      "height": 875,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
