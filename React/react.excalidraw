      "text": "Qus 3 -> Why react component start with uppercase letter?",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Qus 3 -> Why react component start with uppercase letter?",
      "autoResize": true,
