    {
      "id": "GSsUman8oIqwmgzQlCAMs",
      "type": "text",
      "x": 1405.9135407911454,
      "y": 84936.51357219061,
      "width": 1078,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
