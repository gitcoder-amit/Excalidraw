      "type": "text",
      "x": 1345.3471345411454,
      "y": 89800.82216594061,
      "width": 891,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
