      "text": "import { BrowserRouter, Routes, Route } from 'react-router-dom';\nimport Home from './Home';\n\nfunction About() {\n  return <h1>About</h1>;\n}\n\nfunction App() {\n  return (\n    <BrowserRouter>\n      <Routes>\n        <Route path=\"/\" element={<Home />} />\n        <Route path=\"/about\" element={<About />} />\n      </Routes>\n    </BrowserRouter>\n  );\n}\n\nexport default App;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import { BrowserRouter, Routes, Route } from 'react-router-dom';\nimport Home from './Home';\n\nfunction About() {\n  return <h1>About</h1>;\n}\n\nfunction App() {\n  return (\n    <BrowserRouter>\n      <Routes>\n        <Route path=\"/\" element={<Home />} />\n        <Route path=\"/about\" element={<About />} />\n      </Routes>\n    </BrowserRouter>\n  );\n}\n\nexport default App;",
      "autoResize": true,
      "lineHeight": 1.25
    },
