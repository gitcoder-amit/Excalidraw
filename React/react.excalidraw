    {
      "id": "mrPS6lZ7e8A5V7dTbDZ33",
      "type": "text",
      "x": 1097.7260407911454,
      "y": 98476.27529094061,
      "width": 1749,
      "height": 950,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bsN",
      "roundness": null,
      "seed": 769594998,
      "version": 130,
      "versionNonce": 1845068342,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780374685154,
      "link": null,
      "locked": false,
      "text": "import React from \"react\";\nimport { useState, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport { useRef } from \"react\";\n\nconst Home = () => {\n    const persons = [\"John\", \"Jane\", \"Doe\"];\n    \n    return (\n        <div>\n            {persons.map((person, index) => (\n                <li key={index}>{person}</li>  // key is important for list items in React to help identify which items have changed, are added, or are removed\n            ))}\n        </div>\n    )\n};\n\nexport default Home;\n\n\n\n\nreturn (\n        <div>\n            {persons.map((person, index) => (\n                <Fragment key = {index}>\n                    <li>{person}</li>  // key is important for list items in React to help identify which items have changed, are added, or are removed\n                    <li>{person}</li>\n                </Fragment>\n            ))}\n        </div>\n    )\n\n//Index is used as a key here, but in a real application, it's better to use a unique identifier for each item if \navailable (like an ID) instead of the index to avoid potential issues with list reordering. due to the fact that \nusing index as a key can lead to performance issues and bugs when the list items are reordered, added, or removed. \nWhen the list changes, React uses the keys to determine which items have changed, and if the index is used as a key,\n it may not correctly identify changes, leading to unexpected behavior in the UI.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import React from \"react\";\nimport { useState, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport { useRef } from \"react\";\n\nconst Home = () => {\n    const persons = [\"John\", \"Jane\", \"Doe\"];\n    \n    return (\n        <div>\n            {persons.map((person, index) => (\n                <li key={index}>{person}</li>  // key is important for list items in React to help identify which items have changed, are added, or are removed\n            ))}\n        </div>\n    )\n};\n\nexport default Home;\n\n\n\n\nreturn (\n        <div>\n            {persons.map((person, index) => (\n                <Fragment key = {index}>\n                    <li>{person}</li>  // key is important for list items in React to help identify which items have changed, are added, or are removed\n                    <li>{person}</li>\n                </Fragment>\n            ))}\n        </div>\n    )\n\n//Index is used as a key here, but in a real application, it's better to use a unique identifier for each item if \navailable (like an ID) instead of the index to avoid potential issues with list reordering. due to the fact that \nusing index as a key can lead to performance issues and bugs when the list items are reordered, added, or removed. \nWhen the list changes, React uses the keys to determine which items have changed, and if the index is used as a key,\n it may not correctly identify changes, leading to unexpected behavior in the UI.",
      "autoResize": true,
      "lineHeight": 1.25
    },
