      "versionNonce": 1269084342,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780373283289,
      "link": null,
      "locked": false,
      "text": "import React from \"react\";\nimport { useState, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport { useRef } from \"react\";\n\nconst Home = () => {\n    const user = {\n        \"name\": \"Amit\",\n        \"age\": 25,\n        \"city\": \"New York\"\n    }\n    console.log(user);\n    return (\n        <div>\n            <User name={user.name} age={user.age} city={user.city} />\n            <User name={user.name} age={user.age} city=\"Kanpur\" />\n            <User {...user} /> # this will pass whole user object\n            <User {...user} city=\"Ranchi\" /> # this will change only city\n\n\n        </div>\n    )\n};\n\nconst User = ({name, age, city}) => {\n    return (\n        <div>\n            <p>Name: {name}</p>\n            <p>Age: {age}</p>\n            <p>City: {city}</p>\n        </div>\n    )\n};\n\nexport default Home;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import React from \"react\";\nimport { useState, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport { useRef } from \"react\";\n\nconst Home = () => {\n    const user = {\n        \"name\": \"Amit\",\n        \"age\": 25,\n        \"city\": \"New York\"\n    }\n    console.log(user);\n    return (\n        <div>\n            <User name={user.name} age={user.age} city={user.city} />\n            <User name={user.name} age={user.age} city=\"Kanpur\" />\n            <User {...user} /> # this will pass whole user object\n            <User {...user} city=\"Ranchi\" /> # this will change only city\n\n\n        </div>\n    )\n};\n\nconst User = ({name, age, city}) => {\n    return (\n        <div>\n            <p>Name: {name}</p>\n            <p>Age: {age}</p>\n            <p>City: {city}</p>\n        </div>\n    )\n};\n\nexport default Home;",
      "autoResize": true,
      "lineHeight": 1.25
    },
