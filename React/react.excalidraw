    {
      "id": "jAIkFUBzSQm17NWk_T_OU",
      "type": "text",
      "x": 1335.5697907911454,
      "y": 89251.32997844061,
      "width": 1056,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
