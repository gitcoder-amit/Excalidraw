      "type": "text",
      "x": 809.3877278477696,
      "y": 6726.732390274047,
      "width": 495,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
