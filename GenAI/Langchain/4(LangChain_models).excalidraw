    },
    {
      "id": "EJVabGvcK3QY7lCnu6CTj",
      "type": "text",
      "x": 872.6299153477696,
      "y": 6763.970671524047,
      "width": 1177,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2k",
      "roundness": null,
      "seed": 846652449,
      "version": 995,
      "versionNonce": 480999255,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788232574677,
      "link": null,
      "locked": false,
      "text": "We can see some changes are there in both LLMs and if we want to use two different LLM in our Application\nthen we need to write two diff types of code.\nOr initially we have written code using OpenAI apis and after some time due to it is costly we want\nto use Claude API, then we need to change our code base, which is big task.\nSo Standarization became a challenge, OpenAI models, Gemini Models, Clause models are behaving differently;\neven the response we are getting from all these, that is diff also.\n\nLangchain Identified this problem and they said what if we create a standarized interface , using which\nanyone can talk to anycompany in a standardized fashion. Means we dont need to change major things just\nwith small change we can talk to diff diff company apis. this is model interface.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We can see some changes are there in both LLMs and if we want to use two different LLM in our Application\nthen we need to write two diff types of code.\nOr initially we have written code using OpenAI apis and after some time due to it is costly we want\nto use Claude API, then we need to change our code base, which is big task.\nSo Standarization became a challenge, OpenAI models, Gemini Models, Clause models are behaving differently;\neven the response we are getting from all these, that is diff also.\n\nLangchain Identified this problem and they said what if we create a standarized interface , using which\nanyone can talk to anycompany in a standardized fashion. Means we dont need to change major things just\nwith small change we can talk to diff diff company apis. this is model interface.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
