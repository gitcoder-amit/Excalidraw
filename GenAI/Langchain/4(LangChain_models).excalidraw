    {
      "id": "KbHy6bVZ1f3UoyKCYW41Z",
      "type": "text",
      "x": 880.3877278477696,
      "y": 7843.853484024047,
      "width": 1067,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
