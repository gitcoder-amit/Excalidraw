      "isDeleted": false,
      "boundElements": [],
      "updated": 1788233762458,
      "link": null,
      "locked": false,
      "text": "Language models that are specialized for conversational tasks, they take a sequence of messages\nas inputs and return chat messages as outputs(as opposed to using plain text). these are \ntraditionaly newer models and used more in comparison to LLMs.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Language models that are specialized for conversational tasks, they take a sequence of messages\nas inputs and return chat messages as outputs(as opposed to using plain text). these are \ntraditionaly newer models and used more in comparison to LLMs.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
