    {
      "id": "zUw2MSP4kCC8ZjDQ-1Ocq",
      "type": "text",
      "x": 643.7666340977696,
      "y": 15629.705046524046,
      "width": 1133,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
