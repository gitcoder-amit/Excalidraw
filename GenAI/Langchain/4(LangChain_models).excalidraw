      "seed": 93770380,
      "version": 293,
      "versionNonce": 1637023447,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788232574677,
      "link": null,
      "locked": false,
      "text": "LLM APi calls are stateless, it does not know about previous chats or previous data. LLM treats every\nrequest as independent request, it has no memory. this problem is solved by this Component of Langchain\nthat is memory. We can add memory with the help of this.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LLM APi calls are stateless, it does not know about previous chats or previous data. LLM treats every\nrequest as independent request, it has no memory. this problem is solved by this Component of Langchain\nthat is memory. We can add memory with the help of this.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
