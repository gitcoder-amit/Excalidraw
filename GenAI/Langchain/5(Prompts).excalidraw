      "updated": 1791256962112,
      "link": null,
      "locked": false,
      "text": "It is a parameter that controls the randomness of the language model output, It affects how creative\nor deterministic the responses are.\nLower value(0.0 to 0.3) -> more deterministic and predictable\nHigher Value (0.7 to 1.5) -> More random, creative and diverse",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It is a parameter that controls the randomness of the language model output, It affects how creative\nor deterministic the responses are.\nLower value(0.0 to 0.3) -> more deterministic and predictable\nHigher Value (0.7 to 1.5) -> More random, creative and diverse",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
