      "updated": 1791256962112,
      "created": 1790580929238,
      "link": null,
      "locked": false,
      "text": "Embedding Model ->",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Embedding Model ->",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "liZITxZn-9KSFZjm4V9Jj",
      "type": "text",
      "x": 376.7549153477694,
      "y": 24241.298796524046,
      "width": 1419,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b56",
      "roundness": null,
      "seed": 1989186839,
      "version": 290,
      "versionNonce": 928413472,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791256962112,
      "created": 1790580945520,
      "link": null,
      "locked": false,
      "text": "we use this to convert text into vector, so that vector has contextual meaning of that\ntext.\n\nfrom langchain_openai import OpenAIEmbeddings\nfrom dotenv import load_dotenv\n\nload_dotenv()  # Load environment variables from .env file\n\nembeding = OpenAIEmbeddings(model = 'text-embedding-3-large', dimensions=32) # dimensions involves cost as well, so choose wisely\n# \n\nresult = embeding.embed_query('Delhi is the capital of India')\nprint(str(result)) # this will give 32 dimension vector\n\n\n# as much the dimentions vector will capture more contextual meaning",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we use this to convert text into vector, so that vector has contextual meaning of that\ntext.\n\nfrom langchain_openai import OpenAIEmbeddings\nfrom dotenv import load_dotenv\n\nload_dotenv()  # Load environment variables from .env file\n\nembeding = OpenAIEmbeddings(model = 'text-embedding-3-large', dimensions=32) # dimensions involves cost as well, so choose wisely\n# \n\nresult = embeding.embed_query('Delhi is the capital of India')\nprint(str(result)) # this will give 32 dimension vector\n\n\n# as much the dimentions vector will capture more contextual meaning",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
