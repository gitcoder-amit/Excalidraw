    {
      "id": "EAPmNxqWx-0xZFx5kQ7Eo",
      "type": "text",
      "x": 666.7900715977694,
      "y": 20834.529265274046,
      "width": 1069.12109375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5W",
      "roundness": null,
      "seed": 615708384,
      "version": 570,
      "versionNonce": 1704680160,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791257370438,
      "created": 1791257147934,
      "link": null,
      "locked": false,
      "text": "if temprature will be 0 then we will get same answer all the time when we will ask same question\nto our LLM\nif we will increase temprature value then we will see output is changing depending on howmuch we\nhave increase value of temprature \n0.5 ->little change\n1 -> more change\n1.5 -> much change\n2 -> most change",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if temprature will be 0 then we will get same answer all the time when we will ask same question to our LLM\nif we will increase temprature value then we will see output is changing depending on howmuch we have increase value of temprature \n0.5 ->little change\n1 -> more change\n1.5 -> much change\n2 -> most change",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
