    {
      "id": "aXndZBml-LnQwbb4WGF6M",
      "type": "text",
      "x": 321.8564778477694,
      "y": 23761.005827774046,
      "width": 385,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b52",
      "roundness": null,
      "seed": 2101325173,
      "version": 113,
      "versionNonce": 374555360,
      "isDeleted": true,
