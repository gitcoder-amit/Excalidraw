      "isDeleted": true,
      "boundElements": [],
      "updated": 1791256962112,
      "link": null,
      "locked": false,
      "text": "Two flaws to use above\n1. we need to pay to use these apis\n2. we can talk all above with the help of API, hence we dont have control to change anything.\n\n\nThese flaws are solved by open source modesl",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Two flaws to use above\n1. we need to pay to use these apis\n2. we can talk all above with the help of API, hence we dont have control to change anything.\n\n\nThese flaws are solved by open source modesl",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
