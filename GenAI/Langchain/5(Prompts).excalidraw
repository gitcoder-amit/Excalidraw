      "updated": 1791256962112,
      "created": 1790318831992,
      "link": null,
      "locked": false,
      "text": "Ways to use Open Source Models ->\n1 Using Hugging Face inference APIs\n2. Running Locally",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ways to use Open Source Models ->\n1 Using Hugging Face inference APIs\n2. Running Locally",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "JrYFMyA_c2mO6RFKdHpbQ",
      "type": "text",
      "x": 319.9619465977694,
      "y": 23908.517546524046,
      "width": 1012,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b54",
      "roundness": null,
      "seed": 1448739605,
      "version": 569,
      "versionNonce": 496950048,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791256962112,
      "created": 1790318922428,
      "link": null,
      "locked": false,
      "text": "Disadvantages of Open Source LLM models ->\n1 High Hardware Requirements -> running large models(e.g LLama-2-70B) requires expensive GPU\n2 Setup complexity -> requires installation of dependencies like Pytorch, CUDA, Transformers\n3 Lack of RLHF -> Most Open source models don't have fine tuning with human feedback, making\n            them weaker in instruction following\n4 Limited Multimodal Abilities -> Open modesl dont supports images, audios or videos like\n    GPT\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Disadvantages of Open Source LLM models ->\n1 High Hardware Requirements -> running large models(e.g LLama-2-70B) requires expensive GPU\n2 Setup complexity -> requires installation of dependencies like Pytorch, CUDA, Transformers\n3 Lack of RLHF -> Most Open source models don't have fine tuning with human feedback, making\n            them weaker in instruction following\n4 Limited Multimodal Abilities -> Open modesl dont supports images, audios or videos like\n    GPT\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "k19hTYEc9y2B5KcBH_ZwP",
      "type": "text",
      "x": 325.9619465977694,
      "y": 24203.517546524046,
      "width": 198,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b55",
      "roundness": null,
      "seed": 170184185,
      "version": 22,
