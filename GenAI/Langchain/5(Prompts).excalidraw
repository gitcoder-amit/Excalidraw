    {
      "id": "tiaZU1XvasQa2UPeISUOD",
      "type": "text",
      "x": 703.2119465977694,
      "y": 22522.482390274046,
      "width": 1099.1640625,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5r",
      "roundness": null,
      "seed": 1449992928,
      "version": 920,
      "versionNonce": 2064519968,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791260797822,
      "created": 1791260459386,
      "link": null,
      "locked": false,
      "text": "prompt template\n\nPlease summarize the research paper titled \"{Paper_input}\" with the following specifications\nExplanation Style : {style_input}\nExplanation Length: {length_input}\n\n1. Mathematical details:\n    Inclule releavant mathematical equations if present in the paper\n    Explain the mathematical concept using simple, intutive code snipets\nwhere applicable\n\n2. Anologies:\n    Use relatable analogies to simplify complex ideas\n\nIf certain information is not available in the paper respond with, \"insufficient information\navailable\" instead of guessing\n\nEnsure the summary is clear, accurate and alligned with the provided style and length\n\nNow we will give 3 inputs in UI for user and each input will have dropdown to select\n\n20:00",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "prompt template\n\nPlease summarize the research paper titled \"{Paper_input}\" with the following specifications\nExplanation Style : {style_input}\nExplanation Length: {length_input}\n\n1. Mathematical details:\n    Inclule releavant mathematical equations if present in the paper\n    Explain the mathematical concept using simple, intutive code snipets\nwhere applicable\n\n2. Anologies:\n    Use relatable analogies to simplify complex ideas\n\nIf certain information is not available in the paper respond with, \"insufficient information available\" instead of guessing\n\nEnsure the summary is clear, accurate and alligned with the provided style and length\n\nNow we will give 3 inputs in UI for user and each input will have dropdown to select\n\n20:00",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    }
  ],
