      "versionNonce": 680349586,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785380844552,
      "link": null,
      "locked": false,
      "text": "now a days it is LLM APIs",
      "fontSize": 20,
      "fontFamily": 8,
