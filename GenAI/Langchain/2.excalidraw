    {
      "id": "pmgdGW5Pbp20ZX54QR_pR",
      "type": "text",
      "x": 497.9095994992365,
      "y": 638.8306235673513,
      "width": 330,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
