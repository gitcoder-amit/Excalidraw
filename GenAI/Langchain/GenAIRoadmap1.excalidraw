    },
    {
      "id": "yPiDUKs5CpF2TOZGI-_s7",
      "type": "text",
      "x": 2304.2512487289837,
      "y": 4462.980706073278,
      "width": 253,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
