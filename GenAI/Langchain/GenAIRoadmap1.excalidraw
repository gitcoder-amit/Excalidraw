    {
      "id": "sPHNu4LYOYWgDhmSDhDc1",
      "type": "text",
      "x": 1971.0637487289837,
      "y": 6140.508049823278,
      "width": 968,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGh",
      "roundness": null,
      "seed": 1720265836,
      "version": 391,
      "versionNonce": 397280782,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785207732388,
      "link": null,
      "locked": false,
      "text": "It help us remote login securely. means we can login to our machine without accessing it\nphysically. what it needs, it should connected with internet and machine should have IP \naddress.\n\nusing internet, key value pair, IP address we can login in our machihe using ssh. 7:30",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It help us remote login securely. means we can login to our machine without accessing it\nphysically. what it needs, it should connected with internet and machine should have IP \naddress.\n\nusing internet, key value pair, IP address we can login in our machihe using ssh. 7:30",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pE8wV4nMXCdt_hykDUZwZ",
      "type": "text",
      "x": 1833.337609746991,
      "y": -554.1849198773689,
      "width": 902,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGi",
      "roundness": null,
      "seed": 1583406418,
      "version": 608,
      "versionNonce": 836860946,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785210266915,
      "link": null,
      "locked": false,
      "text": "ML Models -> Specific model for some scenario, or specific data\nFoundation Models -> Generalized models, they can do multiple things not just one.\n trained on very massive amount of data, and costly hardware is needed to process.\nExample => LLM(Large Language Models)\n\nGenerative AI we can devide in two types\n1. We are using these Foundation models\n2. We are building Foundation models.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ML Models -> Specific model for some scenario, or specific data\nFoundation Models -> Generalized models, they can do multiple things not just one.\n trained on very massive amount of data, and costly hardware is needed to process.\nExample => LLM(Large Language Models)\n\nGenerative AI we can devide in two types\n1. We are using these Foundation models\n2. We are building Foundation models.",
      "autoResize": true,
      "lineHeight": 1.25
    },
