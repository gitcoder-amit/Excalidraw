    {
      "id": "NY0sWZpiIKDlIAM6qTV_D",
      "type": "text",
      "x": 2208.1264421076967,
      "y": 768.9179353430809,
      "width": 308,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
