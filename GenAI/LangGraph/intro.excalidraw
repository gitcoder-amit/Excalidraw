      "text": "Qus 9 -> State vs Variable in React JS ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Qus 9 -> State vs Variable in React JS ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DOwu37IVPWZB6SB0mwzwY",
      "type": "text",
      "x": 1398.7729157911454,
      "y": 86029.49794719061,
      "width": 1067,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brI",
      "roundness": null,
      "seed": 247079594,
      "version": 944,
      "versionNonce": 550987741,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1781083423556,
      "link": null,
      "locked": false,
      "text": "state and variable both we use to store data, we can store data of anytype like string, boolean,\nobject, array, but when we use varialbe to store this, and we are changing this variable then \nupdated value doesn't come in UI because whenever we change varialbe value then reactjs will not\nrerender component on the other hand when we use state to store variable then on change component\nrerender also happen due to that we see updated value in UI.\n\n\nfunction App(){\n    let color = 'red'\n    return (\n        <div>\n               <h1> state vs variable in react </h1>\n                <h1> {color}</h1>\n                <button onClick = {() => color=\"green\"}></button>\n        </div>\n)\n}\n\nimport {useState} from 'react'\n\nfunction App(){\n    const [color, setColor] = useState('red')\n    return (\n        <div>\n               <h1> state vs variable in react </h1>\n                <h1> {color}</h1>\n                <button onClick = {() => setColor('green')}></button>\n        </div>\n)\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "state and variable both we use to store data, we can store data of anytype like string, boolean,\nobject, array, but when we use varialbe to store this, and we are changing this variable then \nupdated value doesn't come in UI because whenever we change varialbe value then reactjs will not\nrerender component on the other hand when we use state to store variable then on change component\nrerender also happen due to that we see updated value in UI.\n\n\nfunction App(){\n    let color = 'red'\n    return (\n        <div>\n               <h1> state vs variable in react </h1>\n                <h1> {color}</h1>\n                <button onClick = {() => color=\"green\"}></button>\n        </div>\n)\n}\n\nimport {useState} from 'react'\n\nfunction App(){\n    const [color, setColor] = useState('red')\n    return (\n        <div>\n               <h1> state vs variable in react </h1>\n                <h1> {color}</h1>\n                <button onClick = {() => setColor('green')}></button>\n        </div>\n)\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ipR0nXlNcdc6yZFxfWJUy",
      "type": "text",
