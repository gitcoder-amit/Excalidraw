      "isDeleted": true,
      "boundElements": [],
      "updated": 1781083423556,
      "link": null,
      "locked": false,
      "text": "we can apply condition using ternary operator but we can't apply exactly if else.\n\nimport React from \"react\";\nimport { useState } from \"react\";\n\nconst Home = () => {\n    const [name, setName] = useState('amit');\n    return (\n        <div>\n            {name ? <h1>{name}</h1> : <h1>no name</h1>}\n        </div>\n    )\n}\n\nexport default Home;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we can apply condition using ternary operator but we can't apply exactly if else.\n\nimport React from \"react\";\nimport { useState } from \"react\";\n\nconst Home = () => {\n    const [name, setName] = useState('amit');\n    return (\n        <div>\n            {name ? <h1>{name}</h1> : <h1>no name</h1>}\n        </div>\n    )\n}\n\nexport default Home;",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Y5_a_yGInVnO3GwQY5XWC",
      "type": "text",
      "x": 1262.6049470411454,
