      "boundElements": [],
      "updated": 1781083423556,
      "link": null,
      "locked": false,
      "text": "import React from \"react\";\nimport { useState, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\n\nconst Home = () => {\n    const { params } = useParams();\n\n    console.log(params);\n    return (\n        <div>\n            <h1>Get ID from URL</h1>\n        </div>\n    )\n}\n\nexport default Home;",
      "fontSize": 20,
