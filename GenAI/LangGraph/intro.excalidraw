      "seed": 544192310,
      "version": 466,
      "versionNonce": 14392307,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1781083423556,
      "link": null,
      "locked": false,
      "text": "import React from \"react\";\nimport { useState, useEffect } from \"react\";\n\nconst Home = () => {\n    const [name, setName] = useState('amit');\n\n    setName('ravi') # infinite rerender if we are calling this without any event. due to here state\n                    update, then rerendere due to we are not using any condition again state update\n                    then rerender and so on. So whenever we are updating state, we need to update\n                    on a certain event or condition.\n    return (\n        <div>\n            {name ? <h1>{name}</h1> : <h1>no name</h1>}\n        </div>\n    )\n}\n\nexport default Home;\n\n\n\nuseEffect(()=>{setName('ravi)}) -> in this case also infinitre renderiing will be there.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import React from \"react\";\nimport { useState, useEffect } from \"react\";\n\nconst Home = () => {\n    const [name, setName] = useState('amit');\n\n    setName('ravi') # infinite rerender if we are calling this without any event. due to here state\n                    update, then rerendere due to we are not using any condition again state update\n                    then rerender and so on. So whenever we are updating state, we need to update\n                    on a certain event or condition.\n    return (\n        <div>\n            {name ? <h1>{name}</h1> : <h1>no name</h1>}\n        </div>\n    )\n}\n\nexport default Home;\n\n\n\nuseEffect(()=>{setName('ravi)}) -> in this case also infinitre renderiing will be there.",
      "autoResize": true,
      "lineHeight": 1.25
    },
