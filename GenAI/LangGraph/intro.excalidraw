      "updated": 1781083423556,
      "link": null,
      "locked": false,
      "text": "import React from \"react\";\nimport { useState, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport { useRef } from \"react\";\n\nconst Home = () => {\n    const persons = [\"John\", \"Jane\", \"Doe\", 'Smith', 'Emily', 'Michael', 'Sarah', 'David', 'Jessica', 'Daniel'];\n    \n    return (\n        <div>\n            {persons.map((person, index) => (\n                <li style = {{color:index%2==0?\"red\":\"green\"}} key={index}>{person}</li> \n            ))} \n        </div>\n    )\n};\n\nexport default Home;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import React from \"react\";\nimport { useState, useEffect } from \"react\";\nimport { useParams } from \"react-router\";\nimport { useRef } from \"react\";\n\nconst Home = () => {\n    const persons = [\"John\", \"Jane\", \"Doe\", 'Smith', 'Emily', 'Michael', 'Sarah', 'David', 'Jessica', 'Daniel'];\n    \n    return (\n        <div>\n            {persons.map((person, index) => (\n                <li style = {{color:index%2==0?\"red\":\"green\"}} key={index}>{person}</li> \n            ))} \n        </div>\n    )\n};\n\nexport default Home;",
      "autoResize": true,
