    {
      "id": "RVm4mbN79KBLNNQqkzxo2",
      "type": "text",
      "x": 1202.1947907911454,
      "y": 92369.74794719061,
      "width": 1089,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
