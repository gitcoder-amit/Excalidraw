    {
      "id": "gd52llCN39aB8cCR6-jBh",
      "type": "text",
      "x": 1193.3798409127426,
      "y": 109073.83973847446,
      "width": 11,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
