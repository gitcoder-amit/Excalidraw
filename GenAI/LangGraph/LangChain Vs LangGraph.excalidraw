    {
      "id": "uIaSfXPR3vDdwB_plEL8p",
      "type": "text",
      "x": 1361.422809662743,
      "y": 103372.94520722446,
      "width": 1012,
      "height": 200,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bvi",
