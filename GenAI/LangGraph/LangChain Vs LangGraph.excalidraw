    {
      "id": "b_UlEg2TRXrfuszNCYD00",
      "type": "text",
      "x": 1202.9716377877426,
      "y": 99437.06434784946,
      "width": 198,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
