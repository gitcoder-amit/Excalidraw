      "boundElements": [],
      "updated": 1781323703484,
      "link": null,
      "locked": false,
      "text": "state = {\n    \"goal\" : \"Hire a backend software engineer\",\n    \"jd\": \"\",\n    \"jd_approved\" : False,\n    \"jd_posted\" : False,\n    \"min_applications\": 5,\n    \"num_applications\": 0,\n    \"shortlisted_candidates\": {\n        \"candidate_id\": {\"name\":..., \"score\": ..., \"status\": ...}\n    }\n\n    \"interview_questions\" : [],\n    \"offer_status\" : {\n        \"sent\": False,\n        \"accepted\": False,\n        \"renigotiated\": False\n    },\n    \"onboarding_status\": {\n        \"completed\": False,\n        \"start_date\": None, \n        \"employee_id\": None\n     }",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "state = {\n    \"goal\" : \"Hire a backend software engineer\",\n    \"jd\": \"\",\n    \"jd_approved\" : False,\n    \"jd_posted\" : False,\n    \"min_applications\": 5,\n    \"num_applications\": 0,\n    \"shortlisted_candidates\": {\n        \"candidate_id\": {\"name\":..., \"score\": ..., \"status\": ...}\n    }\n\n    \"interview_questions\" : [],\n    \"offer_status\" : {\n        \"sent\": False,\n        \"accepted\": False,\n        \"renigotiated\": False\n    },\n    \"onboarding_status\": {\n        \"completed\": False,\n        \"start_date\": None, \n        \"employee_id\": None\n     }",
      "autoResize": true,
