      "text": "Agents vs Workflows ->",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Agents vs Workflows ->",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2MIL0nmrGx5BdaHcZt1p-",
      "type": "text",
      "x": 1277.3817940377426,
      "y": 100377.93544159946,
      "width": 1001,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "buH",
      "roundness": null,
      "seed": 242033076,
      "version": 413,
      "versionNonce": 1829127732,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781107124573,
      "link": null,
      "locked": false,
      "text": "Workflow -> are systems where LLMs and tools are orchestrated through predefined code path\nin case of workflow flowchart will be constant.\n\nAgent -> On the other hand, are systems where LLMs dynamically direct their own processes\n    and tool usage, maintaining control over how they accomplish tasks. here flowchart will\n    be changed every time according to LLM.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Workflow -> are systems where LLMs and tools are orchestrated through predefined code path\nin case of workflow flowchart will be constant.\n\nAgent -> On the other hand, are systems where LLMs dynamically direct their own processes\n    and tool usage, maintaining control over how they accomplish tasks. here flowchart will\n    be changed every time according to LLM.",
      "autoResize": true,
      "lineHeight": 1.25
    },
