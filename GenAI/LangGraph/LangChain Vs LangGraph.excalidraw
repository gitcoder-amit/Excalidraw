    },
    {
      "id": "ejCziDUfcuuvKFMgf2SIV",
      "type": "text",
      "x": 1189.3368721627426,
      "y": 109076.47255097446,
      "width": 1155,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bwR",
      "roundness": null,
      "seed": 1586622838,
      "version": 616,
      "versionNonce": 332675382,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781397474215,
      "link": null,
      "locked": false,
      "text": "LangGraph is an orchestration framework that enables us to build stateful, multi step and event driven\nworkflows using LLMs, Its ideal for designing both single agent and multi agent, Agentic AI applications.\n\nThink of LangGraph as a flowchart engine for LLMs - we define the steps(nodes), how they are connected\n(edges), and the logic that governs the transitions, LangGraph takes care of state management, \nconditional branching, pausing/resuming and fault recovery - features essential for building robust\nproduction grade AI system.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LangGraph is an orchestration framework that enables us to build stateful, multi step and event driven\nworkflows using LLMs, Its ideal for designing both single agent and multi agent, Agentic AI applications.\n\nThink of LangGraph as a flowchart engine for LLMs - we define the steps(nodes), how they are connected\n(edges), and the logic that governs the transitions, LangGraph takes care of state management, \nconditional branching, pausing/resuming and fault recovery - features essential for building robust\nproduction grade AI system.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7KZJYPnZ7C23RGzY9L1ho",
      "type": "text",
      "x": 1159.3798409127426,
      "y": 109344.83973847446,
      "width": 209,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bwS",
      "roundness": null,
      "seed": 394980918,
      "version": 30,
      "versionNonce": 1608403574,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781397483748,
      "link": null,
      "locked": false,
      "text": "When to use what ->",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When to use what ->",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AP8-9Y5OB_FRDlGiDsyXh",
      "type": "text",
      "x": 1205.6610909127426,
      "y": 109380.14442597446,
      "width": 1056,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bwT",
      "roundness": null,
      "seed": 1746767914,
      "version": 447,
      "versionNonce": 1166492214,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781397654588,
      "link": null,
      "locked": false,
      "text": "Use LangChain when we are building simple, linear workflows - like a prompt chain, summarizer or\na basic retreival system\n\nUse LangGraph when our usecase involves complex,non linear workflows that need\n    1 conditional path\n    2 Loops\n    3 Human in the loop steps \n    4 Multi agent coordination\n    5 Asynchronous or event driven execution",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use LangChain when we are building simple, linear workflows - like a prompt chain, summarizer or\na basic retreival system\n\nUse LangGraph when our usecase involves complex,non linear workflows that need\n    1 conditional path\n    2 Loops\n    3 Human in the loop steps \n    4 Multi agent coordination\n    5 Asynchronous or event driven execution",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wiy734bL-tZYoPRWfWF23",
      "type": "text",
      "x": 1151.3798409127426,
      "y": 109688.83973847446,
      "width": 330,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bwU",
      "roundness": null,
      "seed": 1148036598,
      "version": 33,
      "versionNonce": 456805878,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781397699014,
      "link": null,
      "locked": false,
      "text": "Should we still use LangChain?",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Should we still use LangChain?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "griuG0RNlU03EG9jw_GSd",
      "type": "text",
      "x": 1203.8720284127426,
      "y": 109722.45301972446,
      "width": 1045,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bwV",
      "roundness": null,
      "seed": 292803754,
      "version": 366,
      "versionNonce": 1416983594,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781397842810,
      "link": null,
      "locked": false,
      "text": "Yes, LangGraph is built on top of LangChain, it doesn't replace it\n\nwe will still use LangChain components like\n1 ChatOpenAI(LLMs)\n2 PromptTemplate\n3 Retrievers\n4 Document Loaders\n5 Tools etc\n\nLangGraph handles workflow orchestration, while LangChain provides the building blocks for each\nstep in that workflow.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Yes, LangGraph is built on top of LangChain, it doesn't replace it\n\nwe will still use LangChain components like\n1 ChatOpenAI(LLMs)\n2 PromptTemplate\n3 Retrievers\n4 Document Loaders\n5 Tools etc\n\nLangGraph handles workflow orchestration, while LangChain provides the building blocks for each\nstep in that workflow.",
      "autoResize": true,
      "lineHeight": 1.25
    },
