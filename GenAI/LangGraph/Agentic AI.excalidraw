    },
    {
      "id": "eFPmqgPAAhz6YS4vgvnjJ",
      "type": "text",
      "x": 1137.7060127877426,
      "y": 98434.28505097446,
      "width": 1100,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bsd",
      "roundness": null,
      "seed": 1298622909,
      "version": 741,
      "versionNonce": 943817700,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1781088948265,
      "link": null,
      "locked": false,
      "text": "Generative AI refers to a class of Artificial Intelligence models that can create new content\nsuch as text, images, audio or videos, that resembles human created data.\nExamples -> LLM based apps like ChatGPT\n            Diffusion models for images -> text to image which kind of image we want\n            Code generating LLM like codeLLamma.\n            TTS models like ElevenLabs -> here we provide text and we get a speech like human is\n                        talking.\n            Video gen models like Sora. -> here we will give text and model will provide short video",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Generative AI refers to a class of Artificial Intelligence models that can create new content\nsuch as text, images, audio or videos, that resembles human created data.\nExamples -> LLM based apps like ChatGPT\n            Diffusion models for images -> text to image which kind of image we want\n            Code generating LLM like codeLLamma.\n            TTS models like ElevenLabs -> here we provide text and we get a speech like human is\n                        talking.\n            Video gen models like Sora. -> here we will give text and model will provide short video",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pBT7eALUoMnXuQx7jEifb",
      "type": "text",
