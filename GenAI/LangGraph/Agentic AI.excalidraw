      "isDeleted": true,
      "boundElements": [],
      "updated": 1781088948265,
      "link": null,
      "locked": false,
      "text": "Generative AI ->",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Generative AI ->",
