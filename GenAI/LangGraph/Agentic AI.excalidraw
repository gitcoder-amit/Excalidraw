    },
    {
      "id": "Xs-XslWQgPJm-or2bLUTd",
      "type": "text",
      "x": 1182.8388252877426,
      "y": 101239.06239472446,
      "width": 1023,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "btP",
      "roundness": null,
      "seed": 1281880540,
      "version": 334,
      "versionNonce": 550821732,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781093310868,
      "link": null,
      "locked": false,
      "text": "Adaptability is the agent's ability to modify its plan, strategies or actions in response to \nunexpected conditions - all while staying with the goal\n\n1. Failure (Calender API)\n2. External Feedback (Less no of applicants)\n3. Changing goals (Hiring a FreeLancer)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Adaptability is the agent's ability to modify its plan, strategies or actions in response to \nunexpected conditions - all while staying with the goal\n\n1. Failure (Calender API)\n2. External Feedback (Less no of applicants)\n3. Changing goals (Hiring a FreeLancer)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rXx94jNf9A3f960Khm45N",
      "type": "text",
      "x": 1122.0224190377426,
      "y": 101464.16786347446,
      "width": 11,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
