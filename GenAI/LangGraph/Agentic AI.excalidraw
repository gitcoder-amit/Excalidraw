      "seed": 848092019,
      "version": 403,
      "versionNonce": 212821860,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1781088948265,
      "link": null,
      "locked": false,
      "text": "Traditional AI is about finding patterns in data and giving predictions for new data.\nregression and classification according to some function or ML algo.\nGenerative AI is all about learning the distribution of data so that it can generate a new sample\nfor it. the best part of genAI is that it can mimic humans.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Traditional AI is about finding patterns in data and giving predictions for new data.\nregression and classification according to some function or ML algo.\nGenerative AI is all about learning the distribution of data so that it can generate a new sample\nfor it. the best part of genAI is that it can mimic humans.",
      "autoResize": true,
      "lineHeight": 1.25
    },
