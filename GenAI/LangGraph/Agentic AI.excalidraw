    {
      "id": "R4wMiS4TXfItO_n0NUCBe",
      "type": "text",
      "x": 1126.5185127877426,
      "y": 98744.59755097446,
      "width": 1067,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
