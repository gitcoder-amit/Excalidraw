      "link": null,
      "locked": false,
      "text": "def hiring_request(_ : JDState) -> JDState:\n    return {\"prompt\" : \"we need to hire a software\n            engineer for the backend teams\"}\n\nllm = ChatOpenAI(model = 'gpt-4', temprature = 0)\n\ndef create_jd(state: JDState) -> JDState:\n     prompt = state['prompt']\n     response = llm.invoke(f\"create a job description for this : {prompt}\")\n     return {**state, \"jd\": response.content}\n\ndef check_approval(state: JDState) -> JDState:\n     jd_text = state['jd']\n     approved = \"engineer\" in jd_text.lower() # dummy logic\n     return {**state, \"approved\": approved}\n\ndef approval_router(state: JDState) -> Literal[\"approved\", \"not approved\"]:\n     return \"approved\" if state['approved'] else \"not approved\"\n\ndef post_jd(state: JDState) -> JDState:\n    print(\"final approved JD\")\n    print(state['jd'])\n    return state",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def hiring_request(_ : JDState) -> JDState:\n    return {\"prompt\" : \"we need to hire a software\n            engineer for the backend teams\"}\n\nllm = ChatOpenAI(model = 'gpt-4', temprature = 0)\n\ndef create_jd(state: JDState) -> JDState:\n     prompt = state['prompt']\n     response = llm.invoke(f\"create a job description for this : {prompt}\")\n     return {**state, \"jd\": response.content}\n\ndef check_approval(state: JDState) -> JDState:\n     jd_text = state['jd']\n     approved = \"engineer\" in jd_text.lower() # dummy logic\n     return {**state, \"approved\": approved}\n\ndef approval_router(state: JDState) -> Literal[\"approved\", \"not approved\"]:\n     return \"approved\" if state['approved'] else \"not approved\"\n\ndef post_jd(state: JDState) -> JDState:\n    print(\"final approved JD\")\n    print(state['jd'])\n    return state",
      "autoResize": true,
      "lineHeight": 1.25
    },
