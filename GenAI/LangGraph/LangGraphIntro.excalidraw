    {
      "id": "MCEKv5F6m_9esWTq5OSYW",
      "type": "text",
      "x": 1970.5946846627426,
      "y": 104098.60536347446,
      "width": 825,
      "height": 575,
      "angle": 0,
      "strokeColor": "#e03131",
