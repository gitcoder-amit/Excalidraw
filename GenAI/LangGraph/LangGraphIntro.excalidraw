      "isDeleted": false,
      "boundElements": null,
      "updated": 1781400459000,
      "link": null,
      "locked": false,
      "text": "here we multiple times in series call LLM. Lets say we want to create report on one topic\nso our LLM will take topic and will generate a outline and second LLM will take this outline\ngenerate output like that.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "here we multiple times in series call LLM. Lets say we want to create report on one topic\nso our LLM will take topic and will generate a outline and second LLM will take this outline\ngenerate output like that.",
      "autoResize": true,
      "lineHeight": 1.25
    },
