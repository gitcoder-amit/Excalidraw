    },
    {
      "id": "rC4WxiXTVdSEOaxsmJGGW",
      "type": "text",
      "x": 1414.5960437084052,
      "y": 113143.51452754808,
      "width": 1188,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bzm",
      "roundness": null,
      "seed": 1764372786,
      "version": 935,
      "versionNonce": 1677175346,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781404811857,
      "link": null,
      "locked": false,
      "text": "In LangGraph State is a shared memory and mutable in nature, that flows through our workflow - It holds all\nthe data being passed between nodes as our graph runs.\nWhen we create any graph in LangGraph, LangGraph before creating graph it says first create your state\nand in that state create all the datapoints as key and value, each node has access of it, it canupdate state\nalso. So we give state as input to a node a and node performs some action chagnges state and send this \nstate to next node.\nthis is just a special dictionary we can use TypedDict or pydantic to create this.\n\n\nessay_text: str,\ntopic: str,\ndepth_score: int,\nlanguage_score: int,\nclarity_score: int,\ntotal_score: int,\nfeedback: Annotated[list[str], add]\nevaluation_round: int",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In LangGraph State is a shared memory and mutable in nature, that flows through our workflow - It holds all\nthe data being passed between nodes as our graph runs.\nWhen we create any graph in LangGraph, LangGraph before creating graph it says first create your state\nand in that state create all the datapoints as key and value, each node has access of it, it canupdate state\nalso. So we give state as input to a node a and node performs some action chagnges state and send this \nstate to next node.\nthis is just a special dictionary we can use TypedDict or pydantic to create this.\n\n\nessay_text: str,\ntopic: str,\ndepth_score: int,\nlanguage_score: int,\nclarity_score: int,\ntotal_score: int,\nfeedback: Annotated[list[str], add]\nevaluation_round: int",
      "autoResize": true,
      "lineHeight": 1.25
    },
