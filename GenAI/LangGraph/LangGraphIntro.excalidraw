      "link": null,
      "locked": false,
      "text": "What is LangGraph -> ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is LangGraph -> ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Uj3ovahRbM05Pzg9is3hz",
      "type": "text",
      "x": 1334.6536264944236,
      "y": 106917.6941629793,
      "width": 1078,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bwa",
      "roundness": null,
      "seed": 992213486,
      "version": 426,
      "versionNonce": 1507105074,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781399306815,
      "link": null,
      "locked": false,
      "text": "LangGraph is an orchestration framework for building interlligent, stateful and multi step LLM\nworkflows.\nIt enables advanced features like parallelism, loops, branching, memory andn resumability - making\nit ideal for agentic and production grade AI applications.\nIt models out logic as a graph of nodes(tasks) and edges(routing) instead of linear chain.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LangGraph is an orchestration framework for building interlligent, stateful and multi step LLM\nworkflows.\nIt enables advanced features like parallelism, loops, branching, memory andn resumability - making\nit ideal for agentic and production grade AI applications.\nIt models out logic as a graph of nodes(tasks) and edges(routing) instead of linear chain.",
      "autoResize": true,
      "lineHeight": 1.25
    },
