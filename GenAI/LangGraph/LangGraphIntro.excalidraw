    {
      "id": "4oNzv2P9QmJUbaDzLA-KC",
      "type": "text",
      "x": 1377.856403412743,
      "y": 102272.18348847446,
      "width": 1034,
      "height": 1000,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bve",
      "roundness": null,
      "seed": 527081215,
      "version": 1155,
      "versionNonce": 2056636718,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1781398945275,
      "link": null,
      "locked": false,
      "text": "1. Conditional Branch\n2. Loops\n3. Jumps\n\ndue to these challenges, implement this flowchart in Langchain is difficult\n\n\n# Using LangChaing till post JD implementation\n\nhiring_prompt = \"we need to hire Software Engineer for our Backend team\"\n\n# step 2  Create JD using LLM\nllm = ChatOpenAI(model = \"gpt-4\", temprature = 0)\njd_prompt = ChatPromptTemplate.from_template(\"create job description based on hiring request\")\njd_chain = jd_prompt | llm | StrOutputParser()\n\n# step 3 Approved Function\ndef approve_jd(jd):\n    return 'Approved'\n\n# step 4 Post JD function\ndef post_jd(jd):\n    print(\"JD approved and posted\")\n\n# step 5 Loop until JD is approved\napproved = False\njd_output = None\nwhile not approved:\n    jd_output = jd_chain.invoke(\"request\" : hiring_prompt)\n    print(jd_output)\n    \n    approved = approve_jd(jd_output)\n    \n    if not approved:\n        print(\"jd not approved, regenerating\")\n\n\n# final step\nif approved:\n    post_jd(jd_output)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Conditional Branch\n2. Loops\n3. Jumps\n\ndue to these challenges, implement this flowchart in Langchain is difficult\n\n\n# Using LangChaing till post JD implementation\n\nhiring_prompt = \"we need to hire Software Engineer for our Backend team\"\n\n# step 2  Create JD using LLM\nllm = ChatOpenAI(model = \"gpt-4\", temprature = 0)\njd_prompt = ChatPromptTemplate.from_template(\"create job description based on hiring request\")\njd_chain = jd_prompt | llm | StrOutputParser()\n\n# step 3 Approved Function\ndef approve_jd(jd):\n    return 'Approved'\n\n# step 4 Post JD function\ndef post_jd(jd):\n    print(\"JD approved and posted\")\n\n# step 5 Loop until JD is approved\napproved = False\njd_output = None\nwhile not approved:\n    jd_output = jd_chain.invoke(\"request\" : hiring_prompt)\n    print(jd_output)\n    \n    approved = approve_jd(jd_output)\n    \n    if not approved:\n        print(\"jd not approved, regenerating\")\n\n\n# final step\nif approved:\n    post_jd(jd_output)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
