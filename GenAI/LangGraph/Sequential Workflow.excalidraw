      "updated": 1781490081136,
      "link": null,
      "locked": false,
      "text": "Simple workflow, no branching, no parallel task, no looping, no conditioning simple from task1 to \ntask2, tas2 to task3 and so on.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Simple workflow, no branching, no parallel task, no looping, no conditioning simple from task1 to \ntask2, tas2 to task3 and so on.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KgCvU7-AcanfsHS3Er21u",
      "type": "text",
      "x": 1507.0700657822326,
      "y": 108469.31084685765,
