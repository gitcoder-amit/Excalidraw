    {
      "id": "bhvBPmnu3eFe44aUval_k",
      "type": "text",
      "x": 1914.0491688785364,
      "y": 111752.77124725585,
      "width": 319,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
