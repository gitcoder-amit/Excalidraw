    },
    {
      "id": "5wO3FJPQ7WAEkphgfFYjv",
      "type": "text",
      "x": 1436.4834837738656,
      "y": 112067.54893717564,
      "width": 363,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c01e",
      "roundness": null,
      "seed": 85028588,
      "version": 246,
      "versionNonce": 1049327158,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783910392184,
      "link": null,
      "locked": false,
      "text": "state \n\nessay_text : str\nclarity_of_thought_feedback : str\ndepth_of_analysis_feedback : str\nlanguage_feedback : str\nfinal_feedback : str\nindividual_score : []\nfinal_avg_score = float\n\n33:00",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "state \n\nessay_text : str\nclarity_of_thought_feedback : str\ndepth_of_analysis_feedback : str\nlanguage_feedback : str\nfinal_feedback : str\nindividual_score : []\nfinal_avg_score = float\n\n33:00",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GVv9VNqAmUXZZRKb9EgfD",
      "type": "text",
      "x": 2007.209980233019,
      "y": 112013.25934804547,
      "width": 396,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c01h",
      "roundness": null,
      "seed": 1190445908,
      "version": 93,
      "versionNonce": 1922374996,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781577015335,
      "link": null,
      "locked": false,
      "text": "Here we need reducers as we need to \nmerge value in individual score.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here we need reducers as we need to \nmerge value in individual score.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "LC5T9Gbx2_-UzZdisMGxh",
      "type": "text",
      "x": 1460.4246300572331,
      "y": 112453.06495579575,
      "width": 1155,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c01i",
      "roundness": null,
      "seed": 1909027243,
      "version": 10,
      "versionNonce": 225626443,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781579000754,
      "link": null,
      "locked": false,
      "text": "LangGraph primarily uses asynchronous execution (asyncio) to run independent graph nodes concurrently. \nMost LLM workflows are I/O-bound because they wait on APIs, databases, or vector stores. While one node \nis waiting for a network response, the event loop schedules another node. Internally this is similar to \nasyncio.gather(). For CPU-bound workloads, true parallelism would require multiple processes because the \nPython GIL prevents simultaneous execution of Python bytecode in a single process.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LangGraph primarily uses asynchronous execution (asyncio) to run independent graph nodes concurrently. \nMost LLM workflows are I/O-bound because they wait on APIs, databases, or vector stores. While one node \nis waiting for a network response, the event loop schedules another node. Internally this is similar to \nasyncio.gather(). For CPU-bound workloads, true parallelism would require multiple processes because the \nPython GIL prevents simultaneous execution of Python bytecode in a single process.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XwpnKl3-KNk8YMrpKYg3D",
      "type": "text",
      "x": 1926.3851036336155,
      "y": 112221.56640929691,
      "width": 627,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c01j",
      "roundness": null,
      "seed": 1370261814,
      "version": 339,
      "versionNonce": 1295872618,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783910182333,
      "link": null,
      "locked": false,
      "text": "here we need to use merging since we have more values to \nstore in individual score, bydefault it performs update \nor replace,  So we need reducer function, with the use of\nthat we can perform merging\nSo here we need to use 3 concepts\n1. Parallel Workflow\n2. Structured Output\n3. Reducer Function",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
