    {
      "id": "40NOpI5960mxyAKVuyPC0",
      "type": "text",
      "x": 832.1142903477696,
      "y": 7962.177702774046,
      "width": 231,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
