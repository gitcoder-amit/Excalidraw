    {
      "id": "b8u64fmeDpW28MoDwn_ik",
      "type": "text",
      "x": 530.4619465977696,
      "y": 15531.415984024046,
      "width": 913,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4O",
      "roundness": null,
      "seed": 14293839,
      "version": 5,
      "versionNonce": 1276849313,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788874841365,
      "link": null,
      "locked": false,
      "text": "We'll continue with our AI Enterprise Workspace project and keep the same approach:\nConcept → Why → Real-world example → Project application → Interview question",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We'll continue with our AI Enterprise Workspace project and keep the same approach:\nConcept → Why → Real-world example → Project application → Interview question",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "K4jP_V--I9ZZbmpKpBERn",
      "type": "text",
      "x": 528.4619465977696,
      "y": 15620.415984024046,
      "width": 363,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
