    {
      "id": "Nd274WNQSiTTlF4TS1ZzK",
      "type": "text",
      "x": 814.2353840977696,
      "y": 5746.177702774046,
      "width": 1001,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3g",
