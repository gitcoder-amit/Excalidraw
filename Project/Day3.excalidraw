      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4X",
      "roundness": null,
      "seed": 594850383,
      "version": 4,
      "versionNonce": 776175791,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788875146440,
      "link": null,
      "locked": false,
