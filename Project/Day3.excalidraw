    {
      "id": "YSS-vmcmdj9umgO4Go5A6",
      "type": "text",
      "x": 671.9619465977696,
      "y": 10158.662077774046,
      "width": 1188,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3y",
      "roundness": null,
      "seed": 1121127029,
      "version": 252,
      "versionNonce": 158388591,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788874796942,
      "link": null,
      "locked": false,
      "text": "1. Signup\n    User -> Signup API -> Validate Input -> Hash Password -> Save User -> Send Verification Email\n                 -> success\n\n2. Login\n    User -> Login API -> Find User -> compare password hash -> Generate JWT -> Return Access + Refresh Token\n\n3. Authenticated Request\n    Client ->  GET /projects + bearer token -> Backend -> Verify jwt -> Load User -> check permissions\n            -> Return Projects",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Signup\n    User -> Signup API -> Validate Input -> Hash Password -> Save User -> Send Verification Email\n                 -> success\n\n2. Login\n    User -> Login API -> Find User -> compare password hash -> Generate JWT -> Return Access + Refresh Token\n\n3. Authenticated Request\n    Client ->  GET /projects + bearer token -> Backend -> Verify jwt -> Load User -> check permissions\n            -> Return Projects",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "W9ixcLw2cx2d1CUHsEw9G",
      "type": "text",
      "x": 627.9619465977696,
      "y": 10531.162077774046,
      "width": 209,
      "height": 25,
      "angle": 0,
