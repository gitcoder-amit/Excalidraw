    {
      "id": "5BsQXSEw5DvqFOVC3WJnJ",
      "type": "text",
      "x": 386.3370276018872,
      "y": 29809.906291765656,
      "width": 1100,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4y",
      "roundness": null,
      "seed": 327399748,
      "version": 12,
      "versionNonce": 704358524,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789702506267,
      "created": 1789702453992,
      "link": null,
      "locked": false,
      "text": "The authenticated user should come from the authentication mechanism, typically request.user, \nwhich is established after verifying the JWT. We should not trust a client-provided user_id for \nidentity because the client can modify it. Request-body fields should be treated as untrusted input.\n\nOne nuance\n\nThe JWT itself isn't automatically trustworthy just because it exists.\n\nThe backend must first verify:\n\nSignature\nExpiration\nToken structure\nRelevant claims\n\nThen we can trust the authenticated identity represented by it.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The authenticated user should come from the authentication mechanism, typically request.user, \nwhich is established after verifying the JWT. We should not trust a client-provided user_id for \nidentity because the client can modify it. Request-body fields should be treated as untrusted input.\n\nOne nuance\n\nThe JWT itself isn't automatically trustworthy just because it exists.\n\nThe backend must first verify:\n\nSignature\nExpiration\nToken structure\nRelevant claims\n\nThen we can trust the authenticated identity represented by it.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "mtyq2cUC_JbeHWUS3FW2f",
      "type": "text",
      "x": 443.0380585297222,
      "y": 29909.781452848125,
      "width": 770,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
