    {
      "id": "oH2RDegINAJ4ebVTLjCBT",
      "type": "text",
      "x": 712.1494465977696,
      "y": 11608.783171524046,
      "width": 902,
      "height": 2100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3H",
      "roundness": null,
      "seed": 1396712986,
      "version": 10,
      "versionNonce": 123023125,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785473996429,
      "link": null,
      "locked": false,
      "text": "This shows what data our application stores and how entities relate to each other.\n\n                                     User\n+--------------------------------------------------+\n| id                                               |\n| full_name                                        |\n| email                                            |\n| password                                         |\n| is_active                                        |\n| created_at                                       |\n+--------------------------------------------------+\n          ▲\n          │\n          │ Many-to-Many (through Membership)\n          │\n+--------------------------------------------------+\n|              OrganizationMember                  |\n+--------------------------------------------------+\n| id                                               |\n| organization_id (FK)                             |\n| user_id (FK)                                     |\n| role (Owner/Admin/Member)                        |\n| joined_at                                        |\n+--------------------------------------------------+\n          │\n          │\n          ▼\n+--------------------------------------------------+\n|                 Organization                     |\n+--------------------------------------------------+\n| id                                               |\n| name                                             |\n| slug                                             |\n| owner_id (FK -> User)                            |\n| created_at                                       |\n+--------------------------------------------------+\n          │\n          │ One-to-Many\n          ▼\n+--------------------------------------------------+\n|                     Team                         |\n+--------------------------------------------------+\n| id                                               |\n| organization_id (FK)                             |\n| name                                             |\n| description                                      |\n+--------------------------------------------------+\n          ▲\n          │\n          │ Many-to-Many\n          │\n+--------------------------------------------------+\n|                 TeamMember                       |\n+--------------------------------------------------+\n| id                                               |\n| team_id (FK)                                     |\n| user_id (FK)                                     |\n| role                                              |\n+--------------------------------------------------+\n          │\n          ▼\n+--------------------------------------------------+\n|                    Project                       |\n+--------------------------------------------------+\n| id                                               |\n| team_id (FK)                                     |\n| name                                             |\n| description                                      |\n| status                                           |\n+--------------------------------------------------+\n          │\n          ▼\n+--------------------------------------------------+\n|                     Task                         |\n+--------------------------------------------------+\n| id                                               |\n| project_id (FK)                                  |\n| assignee_id (FK -> User)                         |\n| title                                            |\n| description                                      |\n| priority                                         |\n| status                                           |\n| due_date                                         |\n+--------------------------------------------------+",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This shows what data our application stores and how entities relate to each other.\n\n                                     User\n+--------------------------------------------------+\n| id                                               |\n| full_name                                        |\n| email                                            |\n| password                                         |\n| is_active                                        |\n| created_at                                       |\n+--------------------------------------------------+\n          ▲\n          │\n          │ Many-to-Many (through Membership)\n          │\n+--------------------------------------------------+\n|              OrganizationMember                  |\n+--------------------------------------------------+\n| id                                               |\n| organization_id (FK)                             |\n| user_id (FK)                                     |\n| role (Owner/Admin/Member)                        |\n| joined_at                                        |\n+--------------------------------------------------+\n          │\n          │\n          ▼\n+--------------------------------------------------+\n|                 Organization                     |\n+--------------------------------------------------+\n| id                                               |\n| name                                             |\n| slug                                             |\n| owner_id (FK -> User)                            |\n| created_at                                       |\n+--------------------------------------------------+\n          │\n          │ One-to-Many\n          ▼\n+--------------------------------------------------+\n|                     Team                         |\n+--------------------------------------------------+\n| id                                               |\n| organization_id (FK)                             |\n| name                                             |\n| description                                      |\n+--------------------------------------------------+\n          ▲\n          │\n          │ Many-to-Many\n          │\n+--------------------------------------------------+\n|                 TeamMember                       |\n+--------------------------------------------------+\n| id                                               |\n| team_id (FK)                                     |\n| user_id (FK)                                     |\n| role                                              |\n+--------------------------------------------------+\n          │\n          ▼\n+--------------------------------------------------+\n|                    Project                       |\n+--------------------------------------------------+\n| id                                               |\n| team_id (FK)                                     |\n| name                                             |\n| description                                      |\n| status                                           |\n+--------------------------------------------------+\n          │\n          ▼\n+--------------------------------------------------+\n|                     Task                         |\n+--------------------------------------------------+\n| id                                               |\n| project_id (FK)                                  |\n| assignee_id (FK -> User)                         |\n| title                                            |\n| description                                      |\n| priority                                         |\n| status                                           |\n| due_date                                         |\n+--------------------------------------------------+",
      "autoResize": true,
      "lineHeight": 1.25
    },
