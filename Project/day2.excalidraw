      "text": "Password Hashing Flow",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Password Hashing Flow",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Ld3NWCiG5ra9UIHzk4w0m",
      "type": "text",
      "x": 866.2353840977696,
      "y": 8004.419890274046,
      "width": 1056,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3p",
      "roundness": null,
      "seed": 1492391061,
      "version": 102,
      "versionNonce": 237248405,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785474562081,
      "link": null,
      "locked": false,
      "text": "Password -> Hash Function (bcrypt/Argon2) -> Random Salt Added -> Hash Generated -> Store Hash\n\nDuring login:\n    Entered Password -> Hash Again -> Compare Hashes -> Match? -> if yes login success else fail\nWe never decrypt passwords because there is nothing to decrypt.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Password -> Hash Function (bcrypt/Argon2) -> Random Salt Added -> Hash Generated -> Store Hash\n\nDuring login:\n    Entered Password -> Hash Again -> Compare Hashes -> Match? -> if yes login success else fail\nWe never decrypt passwords because there is nothing to decrypt.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Fpo3RaN62_bVd0ojOWbR3",
      "type": "text",
      "x": 1041.1142903477696,
      "y": 7984.177702774046,
      "width": 11,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
