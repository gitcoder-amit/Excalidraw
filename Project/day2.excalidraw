    {
      "id": "jDVwp1F7EH6Y7eaMv6jqW",
      "type": "text",
      "x": 743.1142903477696,
      "y": 8998.177702774046,
      "width": 11,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
