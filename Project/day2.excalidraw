    {
      "id": "-2QI8aKG-PEHw-afounkr",
      "type": "text",
      "x": 614.0283528477696,
      "y": 18012.665984024046,
      "width": 209,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
