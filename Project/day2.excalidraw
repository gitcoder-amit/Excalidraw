    {
      "id": "6C8mwst8Id3DUc_moiNai",
      "type": "text",
      "x": 684.6416340977696,
      "y": 12926.892546524046,
      "width": 11,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
