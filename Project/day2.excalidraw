      "isDeleted": false,
      "boundElements": [],
      "updated": 1788785894863,
      "link": null,
      "locked": false,
      "text": "1 Why is JWT stateless?",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 Why is JWT stateless?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "pafYRTOX5d-NPkIniRfYX",
      "type": "text",
      "x": 676.9619465977696,
      "y": 10624.162077774046,
      "width": 1122,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b43",
      "roundness": null,
      "seed": 1120693897,
      "version": 8,
      "versionNonce": 1206765671,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788785933924,
      "link": null,
      "locked": false,
      "text": "JWT authentication is considered stateless because the server doesn't need to maintain authentication \nsession state for each client. The token carries the necessary claims and is cryptographically signed,\n so the server can validate it independently on each request.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JWT authentication is considered stateless because the server doesn't need to maintain authentication \nsession state for each client. The token carries the necessary claims and is cryptographically signed,\n so the server can validate it independently on each request.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "W_aKLdZFga03fWkRP4N_o",
      "type": "text",
      "x": 626.9619465977696,
      "y": 10747.162077774046,
      "width": 539,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b44",
      "roundness": null,
      "seed": 142224839,
      "version": 4,
      "versionNonce": 1014763303,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788785944425,
      "link": null,
      "locked": false,
      "text": "2. Why are passwords hashed instead of encrypted?",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Why are passwords hashed instead of encrypted?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "3OU2-RmzrPhJ4c-HtheJC",
      "type": "text",
      "x": 669.9619465977696,
      "y": 10774.162077774046,
      "width": 1111,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b45",
      "roundness": null,
      "seed": 1843610473,
      "version": 7,
      "versionNonce": 1989974631,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788785969976,
      "link": null,
      "locked": false,
      "text": "Passwords should be hashed rather than encrypted because the application never needs to recover \nthe original password. A password hash is one-way, so even if the database is compromised, attackers \ncannot simply decrypt the stored passwords.\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Passwords should be hashed rather than encrypted because the application never needs to recover \nthe original password. A password hash is one-way, so even if the database is compromised, attackers \ncannot simply decrypt the stored passwords.\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "7fieOjWXnU5NVuTQSA1qD",
      "type": "text",
      "x": 622.9619465977696,
      "y": 10901.162077774046,
      "width": 242,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
