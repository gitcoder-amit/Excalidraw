      "boundElements": [],
      "updated": 1785473996429,
      "link": null,
      "locked": false,
      "text": "Qus How does authentication work in our system?\n\nIt searches:\n\nDocumentation\nTasks\nDesign decisions\nCode metadata (where available)\n\nand answers using RAG.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Qus How does authentication work in our system?\n\nIt searches:\n\nDocumentation\nTasks\nDesign decisions\nCode metadata (where available)\n\nand answers using RAG.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
