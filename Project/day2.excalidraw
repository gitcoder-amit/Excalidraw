    {
      "id": "k_lUV82_9oCW7nSYTuLV4",
      "type": "text",
      "x": 700.0283528477696,
      "y": 14401.665984024046,
      "width": 660,
      "height": 825,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3M",
