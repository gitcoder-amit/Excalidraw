    {
      "id": "Nd274WNQSiTTlF4TS1ZzK",
      "type": "text",
      "x": 814.2353840977696,
      "y": 5746.177702774046,
      "width": 1001,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3g",
      "roundness": null,
      "seed": 1516121723,
      "version": 10,
      "versionNonce": 1548321589,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785474044411,
      "link": null,
      "locked": false,
      "text": "Today is one of the most important days in backend engineering.\n\nIf you understand today's concepts deeply, then JWT, OAuth, sessions, cookies, middleware, \nAPI security, refresh tokens, and even microservices will become much easier.\n\n\nWeek 1 Goal\n\nEpic: Authentication & Platform Foundation\n\nYesterday:\n\n✅ Product vision\n✅ Architecture\n✅ ER Diagram\n\nToday:\n\n✅ Authentication Design\n✅ JWT\n✅ Password Hashing\n✅ API Design\n✅ Sequence Diagrams\n\nNo coding today. We are designing like software architects.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Today is one of the most important days in backend engineering.\n\nIf you understand today's concepts deeply, then JWT, OAuth, sessions, cookies, middleware, \nAPI security, refresh tokens, and even microservices will become much easier.\n\n\nWeek 1 Goal\n\nEpic: Authentication & Platform Foundation\n\nYesterday:\n\n✅ Product vision\n✅ Architecture\n✅ ER Diagram\n\nToday:\n\n✅ Authentication Design\n✅ JWT\n✅ Password Hashing\n✅ API Design\n✅ Sequence Diagrams\n\nNo coding today. We are designing like software architects.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
