      "text": "Part 3 (20 Minutes) JWT Authentication",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Part 3 (20 Minutes) JWT Authentication",
      "autoResize": true,
