    {
      "id": "0mAOvRlWf02NFxsh6mxQ8",
      "type": "text",
      "x": 627.9619465977696,
      "y": 10596.162077774046,
      "width": 253,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
