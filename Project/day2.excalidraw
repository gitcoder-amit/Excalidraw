    {
      "id": "f9IRdpi7zRqKxBXI5_-qp",
      "type": "text",
      "x": 595.4619465977696,
      "y": 12306.415984024046,
      "width": 352,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
