    {
      "id": "k_lUV82_9oCW7nSYTuLV4",
      "type": "text",
      "x": 700.0283528477696,
      "y": 14401.665984024046,
      "width": 660,
      "height": 825,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3M",
      "roundness": null,
      "seed": 1816618266,
      "version": 4,
      "versionNonce": 446920518,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785386719895,
      "link": null,
      "locked": false,
      "text": "                              Users\n                                │\n                     Web / Mobile Application\n                                │\n                          HTTPS Request\n                                │\n                        Route53 (Later)\n                                │\n                   Application Load Balancer\n                                │\n                     Nginx / Kubernetes Ingress\n                                │\n                     Django REST API Backend\n                                │\n      ┌──────────────┬───────────────┬───────────────┐\n      │              │               │               │\n      ▼              ▼               ▼               ▼\n Authentication   Workspace      AI Service    Notification\n      │              │               │               │\n      └──────────────┴───────────────┴───────────────┘\n                                │\n                   Business Logic / Services\n                                │\n      ┌──────────────┬───────────────┬───────────────┐\n      │              │               │               │\n      ▼              ▼               ▼               ▼\n PostgreSQL      Redis Cache     Celery Workers    Amazon S3\n      │              │               │               │\n      └──────────────┴───────────────┴───────────────┘\n                                │\n                      Monitoring Layer\n                                │\n        Prometheus → Grafana → Loki → CloudWatch",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                              Users\n                                │\n                     Web / Mobile Application\n                                │\n                          HTTPS Request\n                                │\n                        Route53 (Later)\n                                │\n                   Application Load Balancer\n                                │\n                     Nginx / Kubernetes Ingress\n                                │\n                     Django REST API Backend\n                                │\n      ┌──────────────┬───────────────┬───────────────┐\n      │              │               │               │\n      ▼              ▼               ▼               ▼\n Authentication   Workspace      AI Service    Notification\n      │              │               │               │\n      └──────────────┴───────────────┴───────────────┘\n                                │\n                   Business Logic / Services\n                                │\n      ┌──────────────┬───────────────┬───────────────┐\n      │              │               │               │\n      ▼              ▼               ▼               ▼\n PostgreSQL      Redis Cache     Celery Workers    Amazon S3\n      │              │               │               │\n      └──────────────┴───────────────┴───────────────┘\n                                │\n                      Monitoring Layer\n                                │\n        Prometheus → Grafana → Loki → CloudWatch",
      "autoResize": true,
      "lineHeight": 1.25
    },
