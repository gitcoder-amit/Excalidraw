      "text": "langchain is an open source framework for developing applications powered by LLM.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "langchain is an open source framework for developing applications powered by LLM.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xUeaCK9XM9HQi0UNXPhti",
      "type": "text",
      "x": 779.1494465977696,
      "y": 5864.665984024047,
      "width": 363,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2c",
      "roundness": null,
      "seed": 1880234642,
      "version": 120,
      "versionNonce": 2058748550,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1785385443047,
      "link": null,
      "locked": false,
      "text": "In Langchain we have 6 components\n1 Models\n2 Prompts\n3 Chains\n4 Memory\n5 Indexes\n6 Agents",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In Langchain we have 6 components\n1 Models\n2 Prompts\n3 Chains\n4 Memory\n5 Indexes\n6 Agents",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Q1uKvC4wC52Hyo35muPqq",
      "type": "text",
      "x": 777.0283528477696,
      "y": 6127.665984024047,
      "width": 99,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
