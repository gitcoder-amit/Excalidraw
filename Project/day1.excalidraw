      "isDeleted": false,
      "boundElements": null,
      "updated": 1785386761910,
      "link": null,
      "locked": false,
      "text": "                    User Visits Website\n                             │\n                             ▼\n                      Clicks \"Sign Up\"\n                             │\n                             ▼\n                 Enter Name / Email / Password\n                             │\n                             ▼\n                    Account Created\n                             │\n                             ▼\n                 Email Verification Sent\n                             │\n                             ▼\n                    Verify Email\n                             │\n                             ▼\n                        Login\n                             │\n                             ▼\n                 Access Token + Refresh Token\n                             │\n                             ▼\n                 Create Organization\n                             │\n                             ▼\n                   Invite Team Members\n                             │\n                             ▼\n                     Create Team\n                             │\n                             ▼\n                   Create First Project\n                             │\n                             ▼\n                      Create Tasks\n                             │\n                             ▼\n                 Upload Documents\n                             │\n                             ▼\n                 Ask AI Questions\n                             │\n                             ▼\n             Receive Reports / Notifications",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                    User Visits Website\n                             │\n                             ▼\n                      Clicks \"Sign Up\"\n                             │\n                             ▼\n                 Enter Name / Email / Password\n                             │\n                             ▼\n                    Account Created\n                             │\n                             ▼\n                 Email Verification Sent\n                             │\n                             ▼\n                    Verify Email\n                             │\n                             ▼\n                        Login\n                             │\n                             ▼\n                 Access Token + Refresh Token\n                             │\n                             ▼\n                 Create Organization\n                             │\n                             ▼\n                   Invite Team Members\n                             │\n                             ▼\n                     Create Team\n                             │\n                             ▼\n                   Create First Project\n                             │\n                             ▼\n                      Create Tasks\n                             │\n                             ▼\n                 Upload Documents\n                             │\n                             ▼\n                 Ask AI Questions\n                             │\n                             ▼\n             Receive Reports / Notifications",
      "autoResize": true,
      "lineHeight": 1.25
    },
